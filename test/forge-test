# --- commands.conf: the operator's bound, and the orchestrator's subset ------
# agy has no spatial sandbox (codex gets -s workspace-write, claude gets a
# permission mode), so its only limit is a list of command names. These cover
# the two halves of that: the bound cannot be exceeded, and a subset narrows.

# A commands.conf of its own, so these never depend on the repo's own file.
write_commands_conf() { # write_commands_conf <content>
  printf '%s\n' "$1" > "$TMPROOT/$CURRENT_TEST/commands.conf"
  export FORGE_COMMANDS_FILE="$TMPROOT/$CURRENT_TEST/commands.conf"
}

t_commands_default_grants_the_whole_bound() {
  write_commands_conf "# a comment
ls git   pytest   # trailing comment"
  write_fake_provider "$FAKEBIN/agy" antigravity
  forge spawn --model agy-sonnet c1 "task"
  assert_rc 0 "$RC" "spawn without --commands"
  local st; st="$(await c1)"
  assert_eq "done" "$st" "worker finished"
  local argv="$FORGE_WT_ROOT/c1/ARGV.txt"
  if [[ -f "$argv" ]]; then
    # Every bound command is granted, and comments are not mistaken for one.
    grep -q 'command(ls)' "$argv" && ok || no "bound command 'ls' not granted"
    grep -q 'command(pytest)' "$argv" && ok || no "bound command 'pytest' not granted"
    grep -q 'command(#)' "$argv" && no "a comment became a command rule" || ok
  else
    no "worker never recorded argv"; no "(skipped)"; no "(skipped)"
  fi
  unset FORGE_COMMANDS_FILE
}

t_commands_narrows_to_the_requested_subset() {
  write_commands_conf "ls git pytest curl"
  write_fake_provider "$FAKEBIN/agy" antigravity
  forge spawn --model agy-sonnet --commands "pytest ls" c2 "task"
