}

t_antigravity_effort_is_dropped() {
  # Effort is part of the agy slug; passing --effort as well is a hard error,
  # so forge must drop it rather than fail the spawn.
  write_fake_provider "$FAKEBIN/agy" antigravity
  forge spawn --model agy-sonnet --effort high w7 "task"
  assert_rc 0 "$RC" "spawn an antigravity model with --effort"
  local st; st="$(await w7)"
  assert_eq "done" "$st" "worker finished despite --effort"
  local argv="$FORGE_WT_ROOT/w7/ARGV.txt"
  if [[ -f "$argv" ]]; then
    grep -qx -- '--effort' "$argv" && no "agy argv must not carry --effort" || ok
  else
    no "agy worker never recorded argv"
  fi
}

t_spawn_records_provider_in_state() {
  forge spawn --model gpt-6-luna w3 "task"
  assert_rc 0 "$RC" "spawn codex model"
  await w3 >/dev/null || true
  local prov
  prov="$(cd "$REPO" && jq -r '.provider // empty' .forge/agents/w3.json)"
  assert_eq "codex" "$prov" "provider recorded in agent state"
}

t_spawn_refuses_missing_provider_cli() {
  # The provider's CLI must be genuinely absent, which a bare PATH cannot
  # guarantee: a real agy may be installed on the machine running the
  # tests. So PATH is replaced with the fake bin plus the few tools forge
  # itself needs, and FORGE_AGY_CMD names a command that cannot exist.
  set +e
  OUT="$(cd "$REPO" && PATH="$FAKEBIN:/usr/bin:/bin" \
         FORGE_AGY_CMD="agy-not-installed-$RUN_ID" \
         "$BIN/forge-spawn" --model agy-sonnet w4 "task" 2>&1)"
  RC=$?
  set -e
  assert_rc 1 "$RC" "spawn with the provider CLI absent"
  assert_contains "$OUT" "on PATH" "names the missing executable"
  [[ -f "$REPO/.forge/agents/w4.json" ]] \
    && no "a refused spawn left agent state behind" || ok
  (cd "$REPO" && git show-ref --quiet refs/heads/agent/w4) \
    && no "a refused spawn left a branch behind" || ok
}

t_models_lists_providers_and_roles() {
  forge models
  assert_rc 0 "$RC" "forge-models"
  assert_contains "$OUT" "PROVIDER" "provider column present"
  assert_contains "$OUT" "antigravity" "antigravity models listed"
}

t_usage_reports_antigravity_from_worker() {
  write_fake_provider "$FAKEBIN/agy" antigravity
  forge spawn --model agy-sonnet w5 "task"
  await w5 >/dev/null || true
  [[ -f "$REPO/.forge/usage/w5.json" ]] && ok \
    || no "antigravity usage was not captured from the headless envelope"
  set +e
  OUT="$(cd "$REPO" && "$BIN/forge-usage" --json 2>&1)"; RC=$?
  set -e
  assert_rc 0 "$RC" "forge-usage --json"
  local tot
  tot="$(printf '%s' "$OUT" | jq -r '[.[] | select(.provider=="antigravity") | .total] | add // 0')"
  # TOTAL is derived from the parts (100 in + 20 out + 80 cache), not taken
  # from the envelope's own total_tokens (120). See usage-total-derived.
  assert_eq "200" "$tot" "antigravity total tokens read back with cache"
}

t_usage_total_is_derived_not_trusted() {
  # TOTAL must be the disjoint sum of the parts, whatever the provider's own
  # total_tokens says. agy reports input+output (cache excluded); if a future
  # version switched to including it, trusting that field would double-count
  # the cache or miss it entirely. Both conventions must give the same answer,
  # and a figure that matches neither must raise a visible warning.
  mkdir -p "$REPO/.forge/usage"
  cat > "$REPO/.forge/usage/t_excl.json" <<'EOF'
{"provider":"antigravity","cwd":"CWD","model":"t-excl","usage":{"input_tokens":100,"output_tokens":10,"cache_read_tokens":50,"total_tokens":110}}
EOF
  cat > "$REPO/.forge/usage/t_incl.json" <<'EOF'
{"provider":"antigravity","cwd":"CWD","model":"t-incl","usage":{"input_tokens":100,"output_tokens":10,"cache_read_tokens":50,"total_tokens":160}}
EOF
  cat > "$REPO/.forge/usage/t_bogus.json" <<'EOF'
{"provider":"antigravity","cwd":"CWD","model":"t-bogus","usage":{"input_tokens":100,"output_tokens":10,"cache_read_tokens":50,"total_tokens":9999}}
EOF
  set +e
  OUT="$(cd "$REPO" && "$BIN/forge-usage" --json 2>&1)"; RC=$?
  set -e
  assert_rc 0 "$RC" "forge-usage --json with mixed total conventions"
  local a b
  a="$(printf '%s' "$OUT" | jq -r '[.[]|select(.model=="t-excl")|.total][0] // "none"')"
  b="$(printf '%s' "$OUT" | jq -r '[.[]|select(.model=="t-incl")|.total][0] // "none"')"
  assert_eq "160" "$a" "cache-exclusive total is corrected to the real volume"
  assert_eq "160" "$b" "cache-inclusive total gives the same figure"
  # Neither legitimate convention may be flagged.
  local n
  n="$(printf '%s' "$OUT" | jq -r '[.[]|select(.model=="t-excl" or .model=="t-incl")|.note]|join("")')"
  assert_eq "" "$n" "a known convention raises no note"
  # A figure matching neither must be flagged, in the text output too.
  n="$(printf '%s' "$OUT" | jq -r '[.[]|select(.model=="t-bogus")|.note][0] // ""')"
  assert_contains "$n" "!=" "an impossible provider total is noted"
  set +e
  OUT="$(cd "$REPO" && "$BIN/forge-usage" 2>&1)"
  set -e
  assert_contains "$OUT" "WARNING" "the mismatch is warned about on stdout"
  rm -f "$REPO/.forge/usage/t_excl.json" "$REPO/.forge/usage/t_incl.json" \
        "$REPO/.forge/usage/t_bogus.json"
}

t_usage_json_is_valid_when_empty() {
  set +e
  OUT="$(cd "$REPO" && "$BIN/forge-usage" --json 2>&1)"; RC=$?
  set -e
  assert_rc 0 "$RC" "forge-usage --json with no sessions"
  printf '%s' "$OUT" | jq -e 'type == "array"' >/dev/null \
    && ok || no "forge-usage --json did not produce a JSON array"
}

