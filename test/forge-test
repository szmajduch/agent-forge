# A worktree holds only tracked files, so a gitignored path a task needs must be
# linked in — and must not then show up as untracked and get committed.
t_link_exposes_gitignored_path() {
  mkdir -p "$REPO/.venv" && echo "payload" > "$REPO/.venv/marker.txt"
  printf '.venv/\n' > "$REPO/.gitignore"
  git -C "$REPO" add .gitignore && git -C "$REPO" commit -qm "ignore .venv"

  forge spawn --link .venv ln1 "needs the venv"
  assert_rc 0 "$RC" "spawn with --link"
  assert_eq "done" "$(await ln1)" "worker finished"
  assert_contains "$(cat "$FORGE_WT_ROOT/ln1/.venv/marker.txt" 2>/dev/null || echo MISSING)" \
    "payload" "linked path readable in the worktree"
  # The symlink must not land in the commit.
  case "$(git -C "$REPO" show --name-only --format= agent/ln1)" in
    *.venv*) no "linked .venv was committed" ;; *) ok ;;
  esac
}

