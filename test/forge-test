t_doctor_passes_after_init() {
  forge init >/dev/null 2>&1
  git -C "$REPO" add -A && git -C "$REPO" -c user.email=t@t -c user.name=t commit -qm "forge setup"
  # A models.conf of its own, so the result cannot depend on which providers
  # happen to be installed and signed in on the machine running the tests.
  # An unconfigured provider (no sign-in, no FORGE_AGY_COMMANDS) is a true
  # report about the host, not about the repo under test.
  cat > "$TMPROOT/$CURRENT_TEST/models.conf" <<'EOF'
gpt-6.1-sol  codex  both  everyday work
default gpt-6.1-sol
EOF
  set +e
  OUT="$(cd "$REPO" && PATH="$FAKEBIN:$PATH" \
         FORGE_MODELS_FILE="$TMPROOT/$CURRENT_TEST/models.conf" \
         "$BIN/forge-doctor" 2>&1)"
  RC=$?
  set -e
  # The launcher check compares ~/.local/bin against THIS checkout, so a clone
  # or a second copy legitimately reports BROKEN there. That is the check doing
  # its job, not a failure of the repo under test, so it is excluded here;
  # t_doctor_flags_missing_role_files covers the broken-exit path.
  local broken
  # "not signed in" is excluded for the same reason: a CI runner has no
  # ~/.codex/auth.json and never will, so doctor reporting it is the check
  # working, not the repo being broken. Without this the suite passed only on a
  # machine where the developer happened to be logged in.
  broken="$(printf '%s\n' "$OUT" | grep BROKEN \
            | grep -v "forge copy\|not on PATH\|not signed in" || true)"
  [[ -z "$broken" ]] && ok || no "doctor after init reported: $broken"
  assert_contains "$OUT" "role files are committed" "doctor confirms worker visibility"
}

