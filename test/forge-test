#!/usr/bin/env bash
# forge-test [name-filter] — end-to-end tests for the forge-* commands.
#
# Each test gets a throwaway git repo in a temp dir and a fake `codex` (see
# fake_codex below), so nothing talks to a real model and nothing touches your
# projects. The worktree root and tmux session are per-run, so a failed test
# cannot leave state that breaks the next one.
#
# Run:  test/forge-test            all tests
#       test/forge-test merge      only tests whose name contains "merge"
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
FORGE_HOME="$(cd "$HERE/.." && pwd)"
BIN="$FORGE_HOME/bin"
FILTER="${1:-}"

# A unique session/worktree namespace per run, so a real "forge" session and a
# parallel run of this script are never touched.
RUN_ID="t$$"
export FORGE_SESSION="forge-test-$RUN_ID"
TMPROOT="$(mktemp -d "${TMPDIR:-/tmp}/forge-test.XXXXXX")"

pass=0; fail=0; failed_names=()

cleanup() {
  tmux kill-session -t "$FORGE_SESSION" 2>/dev/null || true
  # Worktrees hold no state we need; force-remove the whole namespace.
  rm -rf "$TMPROOT"
}
trap cleanup EXIT

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }
# Assertion diagnostics go to stderr so a test's own stdout can be suppressed
# without hiding why it failed.
err()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }

# --- assertions ---------------------------------------------------------------
# Every assertion prints what it expected and what it got, so a failure is
# diagnosable from the log alone without rerunning.

ok() { pass=$((pass+1)); }
no() { # no <message>
  fail=$((fail+1)); failed_names+=("$CURRENT_TEST")
  err "
    FAIL [$CURRENT_TEST]: $*"
}

assert_rc() { # assert_rc <expected> <actual> <what>
  [[ "$1" == "$2" ]] && { ok; return; }
  no "$3: expected exit $1, got $2"
}

assert_contains() { # assert_contains <haystack> <needle> <what>
  case "$1" in *"$2"*) ok ;; *) no "$3: expected to contain '$2', got: $(printf '%s' "$1" | head -3)" ;; esac
}

assert_eq() { # assert_eq <expected> <actual> <what>
  [[ "$1" == "$2" ]] && { ok; return; }
  no "$3: expected '$1', got '$2'"
}

assert_file() { # assert_file <path> <what>
  [[ -f "$1" ]] && { ok; return; }
  no "$2: expected file to exist: $1"
}

assert_no_file() { # assert_no_file <path> <what>
  [[ ! -e "$1" ]] && { ok; return; }
  no "$2: expected path NOT to exist: $1"
}

# --- fixtures ----------------------------------------------------------------

# A fake codex honouring the same CLI shape forge uses: `codex exec [args] <prompt>`.
# Behaviour is driven by the mode baked into the script (see write_fake_codex).
#   ok       — writes a report + a code change, exits 0
#   report   — writes only a report (analysis worker), exits 0
#   noop     — changes nothing, exits 0  → expect status "nochanges"
#   fail     — writes nothing, exits 7   → expect status "failed"
# The mode and argv-log path are written INTO the script, not passed through the
# environment: forge-spawn forwards only a whitelist of FORGE_* variables into
# the worker's tmux window, so an exported FAKE_CODEX_* would never arrive.
write_fake_codex() { # write_fake_codex <path> [mode] [argv-log]
  local path="$1" mode="${2:-ok}" argv_log="${3:-}"
  cat > "$path" <<EOF
#!/usr/bin/env bash
MODE="$mode"
ARGV_LOG="$argv_log"
EOF
  cat >> "$path" <<'EOF'
# Fake codex for forge tests. Records its argv so tests can assert on flags.
echo "ARGV: $*"
[[ -n "$ARGV_LOG" ]] && printf '%s\n' "$*" > "$ARGV_LOG"
name="$(basename "$PWD")"
case "$MODE" in
  ok)     mkdir -p reports; echo "# report $name" > "reports/$name.md"
          echo "change by $name" > "changed-$name.txt" ;;
  report) mkdir -p reports; echo "# analysis $name" > "reports/$name.md" ;;
  legacy) echo "# legacy root report" > FORGE_REPORT.md ;;
  noop)   : ;;
  fail)   echo "fake codex failure" >&2; exit 7 ;;
esac
exit 0
EOF
  chmod +x "$path"
}

# new_repo <dir> — a minimal committed git repo to act as the "project".
new_repo() {
  local d="$1"
  mkdir -p "$d"
  git -C "$d" init -q -b main
  git -C "$d" config user.email forge-test@example.invalid
  git -C "$d" config user.name "forge test"
  echo "seed" > "$d/README.md"
  git -C "$d" add -A
  git -C "$d" commit -qm "init"
}

# Runs a forge command inside the test repo. Captures stdout+stderr into $OUT
# and the exit code into $RC, so a failing command never aborts the suite.
forge() { # forge <command-without-prefix> [args...]
  local cmd="$1"; shift
  set +e
  OUT="$(cd "$REPO" && PATH="$FAKEBIN:$PATH" "$BIN/forge-$cmd" "$@" 2>&1)"
  RC=$?
  set -e
}

# Waits until an agent leaves queued/running, or gives up. forge-run executes
# asynchronously in tmux, so tests must not assume it finished.
await() { # await <name> [max_seconds]
  local name="$1" max="${2:-30}" i=0 st
  while [[ $i -lt $((max * 4)) ]]; do
    st="$(cd "$REPO" && "$BIN/forge-status" --json 2>/dev/null \
          | jq -r --arg n "$name" '.[] | select(.name==$n) | .status' 2>/dev/null)"
    case "$st" in queued|running|"") ;; *) echo "$st"; return 0 ;; esac
    sleep 0.25; i=$((i+1))
  done
  echo "TIMEOUT(status=$st)"
  return 1
}

status_of() { # status_of <name>
  (cd "$REPO" && "$BIN/forge-status" --json 2>/dev/null \
    | jq -r --arg n "$1" '.[] | select(.name==$n) | .status')
}

# --- test driver -------------------------------------------------------------
# Each test runs in its own repo + worktree namespace. Isolation is per-test on
# purpose: a test that corrupts state must not cascade into the others.
run_test() { # run_test <name> <function>
  local name="$1" fn="$2"
  case "$name" in *"$FILTER"*) ;; *) return 0 ;; esac
  CURRENT_TEST="$name"
  local before_fail=$fail

  REPO="$TMPROOT/$name/repo"
  FAKEBIN="$TMPROOT/$name/bin"
  export FORGE_WT_ROOT="$TMPROOT/$name/wt"
  export FORGE_KEEP_WINDOW=0
  unset FORGE_CODEX_ARGS FORGE_REPORT_DIR FORGE_BASE FORGE_LINK 2>/dev/null || true
  mkdir -p "$FAKEBIN"
  write_fake_codex "$FAKEBIN/codex"           # default mode: ok
  ARGV_LOG="$TMPROOT/$name/argv.txt"
  new_repo "$REPO"

  printf '  %-34s' "$name"
  # Assertion failures print via no(); a test's own stray output is hidden so
  # the summary stays readable.
  "$fn" >/dev/null || true
  if [[ $fail -gt $before_fail ]]; then red "FAIL"; else green "ok"; fi
}

# A variant that shows assertion messages inline (they are printed by no()).
run_test_verbose() { run_test "$@"; }

