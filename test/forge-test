# --- concurrency cap --------------------------------------------------------

# The limit must be enforced in code: FORGE.md asks the orchestrator to keep to
# four workers, but guidance in a prompt does not stop a fan-out.
t_spawn_enforces_worker_limit() {
  # A fake codex that blocks, so the workers stay "running".
  cat > "$FAKEBIN/codex" <<'XEOF'
#!/usr/bin/env bash
sleep 30
XEOF
  chmod +x "$FAKEBIN/codex"

  FORGE_MAX_WORKERS=2 forge spawn lim1 "one"
  assert_rc 0 "$RC" "first worker within the limit"
  FORGE_MAX_WORKERS=2 forge spawn lim2 "two"
  assert_rc 0 "$RC" "second worker within the limit"

  # Wait for both to actually be running before testing the cap.
  local i=0
  while [[ $i -lt 40 ]]; do
    [[ "$(cd "$REPO" && "$BIN/forge-status" --json | jq '[.[] | select(.status=="running")] | length')" -ge 2 ]] && break
    sleep 0.25; i=$((i+1))
  done

  FORGE_MAX_WORKERS=2 forge spawn lim3 "three"
  assert_rc 1 "$RC" "third worker refused at the limit"
  assert_contains "$OUT" "already active" "limit message names the active count"
  assert_contains "$OUT" "--force" "limit message offers the override"
  # A refused spawn must leave nothing behind.
  assert_no_file "$FORGE_WT_ROOT/lim3" "refused spawn created no worktree"
  git -C "$REPO" show-ref --quiet refs/heads/agent/lim3 \
    && no "refused spawn left a branch behind" || ok

  # --force overrides it.
  FORGE_MAX_WORKERS=2 forge spawn --force lim4 "four"
  assert_rc 0 "$RC" "--force overrides the limit"

  # Clean up the blocked workers so the suite does not wait on them.
  for n in lim1 lim2 lim4; do
    tmux kill-window -t "$FORGE_SESSION:$n" 2>/dev/null || true
  done
}

