t_base_ref_sets_start_point() {
  # A second commit on main; the worker starts from the first one.
  local first; first="$(git -C "$REPO" rev-parse HEAD)"
  echo "later" > "$REPO/later.txt"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm "second commit"

  forge spawn --base "$first" bs1 "start from the first commit"
  assert_rc 0 "$RC" "spawn with --base"
  assert_eq "done" "$(await bs1)" "worker finished"
  # The worker must not see the later commit's file.
  assert_no_file "$FORGE_WT_ROOT/bs1/later.txt" "worker started from the given base"
  local recorded
  recorded="$(cd "$REPO" && "$BIN/forge-status" --json | jq -r '.[] | select(.name=="bs1") | .base_sha')"
  assert_eq "$first" "$recorded" "base_sha recorded"
