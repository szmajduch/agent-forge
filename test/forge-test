  if [[ -f "$argv" ]]; then
    grep -q 'command(pytest)' "$argv" && ok || no "requested 'pytest' not granted"
    # The point of narrowing: what the task does not need is not granted,
    # even though the operator allows it.
    grep -q 'command(curl)' "$argv" && no "unrequested 'curl' leaked into the subset" || ok
    grep -q 'command(git)' "$argv" && no "unrequested 'git' leaked into the subset" || ok
  else
    no "worker never recorded argv"; no "(skipped)"; no "(skipped)"
  fi
  unset FORGE_COMMANDS_FILE
}

t_commands_cannot_exceed_the_bound() {
  # The orchestrator reads task briefs, so it can be argued into asking for
  # more than a task needs. Widening stays the operator's decision.
  write_commands_conf "ls pytest"
