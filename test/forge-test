# --- regression tests for the argument-handling bugs -------------------------

t_status_json_empty() {
  forge status --json
  assert_rc 0 "$RC" "forge-status --json with no agents"
  assert_eq "[]" "$(printf '%s' "$OUT" | tr -d '[:space:]')" "empty JSON array"
  # Must be parseable: the orchestrator reads worktree paths out of this.
  printf '%s' "$OUT" | jq -e 'type == "array"' >/dev/null \
    && ok || no "forge-status --json output is not valid JSON"
}

t_status_plain_empty() {
  forge status
  assert_rc 0 "$RC" "forge-status with no agents"
  assert_contains "$OUT" "no agents yet" "empty status message"
}

t_status_unknown_agent() {
  forge status nope
  assert_rc 1 "$RC" "forge-status <unknown>"
  assert_contains "$OUT" "no such agent" "unknown agent message"
}

t_status_invalid_name() {
  forge status "BAD NAME"
  assert_rc 1 "$RC" "forge-status <invalid name>"
  assert_contains "$OUT" "invalid agent name" "invalid name message"
}

t_wait_timeout_missing_value() {
  forge wait --timeout
  assert_rc 1 "$RC" "forge-wait --timeout with no value"
  assert_contains "$OUT" "needs a value" "missing timeout value message"
}

t_wait_timeout_not_a_number() {
  forge wait --timeout abc
  assert_rc 1 "$RC" "forge-wait --timeout abc"
  assert_contains "$OUT" "whole number" "non-numeric timeout message"
}

t_wait_timeout_equals_form() {
  forge wait --timeout=5
  assert_rc 0 "$RC" "forge-wait --timeout=5 with no agents"
}

t_wait_unknown_option() {
  forge wait --bogus
  assert_rc 1 "$RC" "forge-wait --bogus"
  assert_contains "$OUT" "unknown option" "unknown option message"
}

t_run_without_name() {
  forge run
  assert_rc 1 "$RC" "forge-run with no argument"
  assert_contains "$OUT" "usage" "forge-run usage message"
}

t_drop_rejects_extra_args() {
  forge drop a b
  assert_rc 1 "$RC" "forge-drop with two names"
  assert_contains "$OUT" "exactly one agent" "drop arity message"
}

# The regression that mattered most: a typo in --keep must not delete the
# worktree and branch, because removal is the default.
t_merge_rejects_typo_flag() {
  forge spawn k1 "typo test"
  assert_rc 0 "$RC" "spawn for typo test"
  assert_eq "done" "$(await k1)" "k1 finished"

  forge merge k1 --kep
  assert_rc 1 "$RC" "forge-merge --kep (typo)"
  assert_contains "$OUT" "unknown option" "typo flag message"
  # The whole point: nothing was destroyed.
  assert_file "$FORGE_WT_ROOT/k1/changed-k1.txt" "worktree kept after refused merge"
  assert_eq "done" "$(status_of k1)" "status unchanged after refused merge"
}

t_merge_rejects_two_names() {
  forge merge a b
  assert_rc 1 "$RC" "forge-merge with two names"
  assert_contains "$OUT" "too many arguments" "merge arity message"
}

# --- lifecycle ---------------------------------------------------------------

t_build_worker_commits() {
  forge spawn b1 "build something"
  assert_rc 0 "$RC" "spawn build worker"
  assert_eq "done" "$(await b1)" "build worker reached done"

  # The commit must carry both the code change and the report.
  local files
  files="$(git -C "$REPO" show --name-only --format= "agent/b1")"
  assert_contains "$files" "changed-b1.txt" "code change committed"
  assert_contains "$files" "reports/b1.md" "report committed alongside the change"
  assert_file "$REPO/.forge/logs/b1.log" "worker log written"
}

t_analysis_worker_commits_report() {
  write_fake_codex "$FAKEBIN/codex" report
  forge spawn --kind analysis a1 "analyse something"
  assert_rc 0 "$RC" "spawn analysis worker"
  assert_eq "done" "$(await a1)" "analysis worker reached done"
  assert_contains "$(git -C "$REPO" show --name-only --format= agent/a1)" \
    "reports/a1.md" "analysis report committed"
}

# A worker that changes nothing is not a success: the status must say so,
# because "done" is what the orchestrator is told to trust.
t_noop_worker_is_nochanges() {
  write_fake_codex "$FAKEBIN/codex" noop
  forge spawn n1 "do nothing"
  assert_eq "nochanges" "$(await n1)" "no-op worker reported nochanges"
}

t_failed_worker_keeps_worktree() {
  write_fake_codex "$FAKEBIN/codex" fail
  forge spawn f1 "fail please"
  assert_eq "failed" "$(await f1)" "failing worker reported failed"
  local rc_field
  rc_field="$(cd "$REPO" && "$BIN/forge-status" --json | jq -r '.[] | select(.name=="f1") | .exit_code')"
  assert_eq "7" "$rc_field" "exit code recorded"
  # Left for inspection — that is the documented contract.
  assert_file "$FORGE_WT_ROOT/f1/.git" "failed worker's worktree kept for inspection"
}

t_legacy_root_report_is_moved() {
  write_fake_codex "$FAKEBIN/codex" legacy
  forge spawn l1 "legacy report"
  assert_eq "done" "$(await l1)" "legacy-report worker finished"
  local files
  files="$(git -C "$REPO" show --name-only --format= agent/l1)"
  assert_contains "$files" "reports/l1.md" "FORGE_REPORT.md moved to reports/"
  case "$files" in *FORGE_REPORT.md*) no "FORGE_REPORT.md left in the repo root" ;; *) ok ;; esac
}

t_merge_removes_by_default() {
  forge spawn m1 "merge me"
  assert_eq "done" "$(await m1)" "worker finished"
  forge merge m1
  assert_rc 0 "$RC" "forge-merge"
  assert_eq "merged" "$(status_of m1)" "status merged"
  assert_no_file "$FORGE_WT_ROOT/m1" "worktree removed by default"
  git -C "$REPO" show-ref --quiet refs/heads/agent/m1 \
    && no "branch agent/m1 still exists after merge" || ok
  # --no-ff: the merge is its own commit, so the worker stays one visible unit.
  assert_contains "$(git -C "$REPO" log -1 --format=%s)" "forge: merge agent/m1" "merge commit subject"
}

t_merge_keep_preserves() {
  forge spawn m2 "keep me"
  assert_eq "done" "$(await m2)" "worker finished"
  forge merge m2 --keep
  assert_rc 0 "$RC" "forge-merge --keep"
  assert_file "$FORGE_WT_ROOT/m2/changed-m2.txt" "worktree kept with --keep"
  git -C "$REPO" show-ref --quiet refs/heads/agent/m2 && ok \
    || no "branch agent/m2 removed despite --keep"
}

t_merge_flag_before_name() {
  forge spawn m3 "flag first"
  assert_eq "done" "$(await m3)" "worker finished"
  forge merge --keep m3
  assert_rc 0 "$RC" "forge-merge --keep <name> (flag first)"
  assert_file "$FORGE_WT_ROOT/m3/changed-m3.txt" "worktree kept with leading --keep"
}

t_merge_refuses_non_done() {
  write_fake_codex "$FAKEBIN/codex" fail
  forge spawn m4 "will fail"
  assert_eq "failed" "$(await m4)" "worker failed"
  forge merge m4
  assert_rc 1 "$RC" "merging a failed worker"
  assert_contains "$OUT" "only done" "refusal mentions the allowed states"
}

t_merge_refuses_dirty_repo() {
  forge spawn m5 "dirty test"
  assert_eq "done" "$(await m5)" "worker finished"
  echo "uncommitted" >> "$REPO/README.md"
  forge merge m5
  assert_rc 1 "$RC" "merge with a dirty main repo"
  assert_contains "$OUT" "uncommitted changes" "dirty-repo refusal"
}

t_merge_conflict_aborts_cleanly() {
  # Both sides change the same file, so the merge must conflict.
  forge spawn c1 "conflict side" >/dev/null 2>&1
  await c1 >/dev/null
  # Make the worker's change conflict: it wrote changed-c1.txt, so write the
  # same path on main with different content.
  echo "main version" > "$REPO/changed-c1.txt"
  git -C "$REPO" add -A && git -C "$REPO" commit -qm "main writes the same file"

  forge merge c1
  assert_rc 1 "$RC" "conflicting merge exits non-zero"
  assert_eq "conflict" "$(status_of c1)" "status set to conflict"
  # A left-behind MERGE_HEAD would block every later git operation.
  assert_no_file "$REPO/.git/MERGE_HEAD" "merge aborted cleanly (no MERGE_HEAD)"
  # And a conflict must be recoverable: forge-merge accepts "conflict" again.
  forge merge c1
  assert_contains "$OUT" "conflict" "re-merge still reports the conflict"
}

t_drop_discards_work() {
  forge spawn d1 "drop me"
  assert_eq "done" "$(await d1)" "worker finished"
  forge drop d1
  assert_rc 0 "$RC" "forge-drop"
  assert_eq "dropped" "$(status_of d1)" "status dropped"
  assert_no_file "$FORGE_WT_ROOT/d1" "worktree removed"
  git -C "$REPO" show-ref --quiet refs/heads/agent/d1 \
    && no "branch still exists after drop" || ok
}

