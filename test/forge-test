# --- providers: routing, roles and usage accounting -------------------------
# A fake CLI per provider, so argv can be asserted without a network call.
# The mode is baked into the script rather than exported: forge-spawn forwards
# only a whitelist of variables into the tmux window, so an exported setting
# would silently never arrive (this bit us before).
write_fake_provider() { # write_fake_provider <path> <kind>
  local path="$1" kind="$2"
  cat > "$path" <<EOF
#!/usr/bin/env bash
KIND="$kind"
EOF
  cat >> "$path" <<'EOF'
printf '%s\n' "$@" > ./ARGV.txt
mkdir -p reports; echo "# report" > "reports/$(basename "$PWD").md"
echo "changed" > "changed-by-$KIND.txt"
if [[ "$KIND" == "antigravity" ]]; then
  # A notice before the envelope, as the real agy prints, so the parser is
  # exercised on "last complete JSON object" rather than "the only one".
  echo "jetski: starting"
  echo '{"conversation_id":"c1","status":"SUCCESS","response":"ok","duration_seconds":1,"num_turns":1,"usage":{"input_tokens":100,"output_tokens":20,"thinking_tokens":5,"cache_read_tokens":80,"total_tokens":120}}'
fi
if [[ "$KIND" == "antigravity-denied" ]]; then
  echo '{"conversation_id":"c2","status":"SUCCESS","response":"","duration_seconds":1,"num_turns":1,"usage":{"input_tokens":10,"output_tokens":2,"thinking_tokens":0,"cache_read_tokens":0,"total_tokens":12},"denied_actions":[{"action":"command","display_name":"RunCommand"}]}'
fi
exit 0
EOF
  chmod +x "$path"
}

