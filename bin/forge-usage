#!/usr/bin/env python3
"""forge-usage [--json] [--all] [--since <days>]

Token usage per provider and model, read from what the provider CLIs write on
this machine. No network calls, no API keys: this only reads local session logs.

Default scope is this repo's forge workers plus the orchestrator session(s) for
this repo. --all drops the repo filter and reports every local session.

Why each provider is read differently:

  codex   ~/.codex/sessions/**/rollout-*.jsonl
          Writes `token_usage_record` per response, carrying a cumulative
          `thread_token_usage`, and `event_msg/token_count` carrying
          `rate_limits` + `model_context_window`. This is the only provider
          that reports plan quota, so it is the only one where "percent left"
          is a real number rather than a guess.

  claude  ~/.claude/projects/<slug>/<session>.jsonl
          Each assistant message carries `message.usage`. There is no plan
          quota in these files, so percentages are context-window based only.

  antigravity
          forge's own .forge/usage/<worker>.json. `agy -p --output-format
          json` ends with an envelope carrying {input_tokens, output_tokens,
          thinking_tokens, cache_read_tokens, total_tokens}, but keeps no
          durable per-turn log, so forge-run stores what it printed; see
          _agy_usage. Without a run there is nothing to read.
          (The `gemini` provider was removed on 2026-10-30 — Google no longer
          serves Gemini CLI to personal accounts.)

Totals: every provider prints a total of its own and they disagree on what it
includes, so none of them is trusted — TOTAL is derived from the parts (see
_TOTAL_PARTS and _check_total) and the provider's figure is only used as a
cross-check. A mismatch becomes a visible warning rather than a wrong number.

Percentages: a session's context use is `last_total / context_window`, which is
what decides when a session must compact. Plan quota is shown only when the
provider states it (codex). Nothing here is extrapolated into a cost estimate:
forge does not know your plan's prices.
"""
import argparse
import glob
import json
import os
import sys
import time

HOME = os.path.expanduser("~")

# Context windows used for the per-session "context left" figure. A model that
# is not listed falls back to whatever the session log states, and when neither
# is known the percentage is omitted rather than invented.
# Verified 2026-10-29 against the Anthropic model table: the Claude 5 family is
# 1M, and Haiku 4.5 (200k) is the exception, so a bare "haiku" is not assumed.
# An unlisted model yields no percentage rather than a wrong one.
CONTEXT_WINDOWS = {
    "opus": 1_000_000,
    "sonnet": 1_000_000,
    "haiku": 1_000_000,
    "haiku-4-5": 200_000,
    # Antigravity slugs, as `agy models` prints them. The Gemini Flash and
    # Claude 4.6 context windows are 1M; GPT-OSS 120B is not documented as
    # such, so it is left out rather than guessed.
    "gemini-3.8-flash": 1_000_000,
    "claude-sonnet-4-6": 1_000_000,
    "claude-opus-4-6": 1_000_000,
    # forge's own antigravity names, since that is what gets recorded.
    "agy-gemini": 1_000_000,
    "agy-sonnet": 1_000_000,
    "agy-opus": 1_000_000,
}


def _f(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except ValueError:
                    continue
    except OSError:
        return


def _blank(provider, model, session, cwd=""):
    return {
        "provider": provider, "model": model, "session": session, "cwd": cwd,
        "input": 0, "output": 0, "cached": 0, "cache_write": 0,
        "reasoning": 0, "total": 0,
        "context_window": 0, "last_total": 0, "mtime": 0.0,
        "plan": "", "quota": None, "note": "",
    }


# What TOTAL means in this tool, for every provider: the billed volume, which
# is the disjoint sum of the four input/output buckets.
#
# `reasoning` is deliberately NOT in the sum. Every provider reports it as a
# subset of output_tokens, not alongside it (measured on agy 1.4.11: Gemini
# Flash output=55 with thinking=54), so adding it would double-count.
#
# Each provider also prints a total of its own, and they do not agree on what
# it includes — codex counts cache in, agy's is input+output only. Rather than
# pick one and hope, forge derives the figure and _check_total compares it with
# what the provider said, so a changed convention surfaces as a note instead of
# a silently wrong number.
_TOTAL_PARTS = ("input", "output", "cached", "cache_write")


def derived_total(rec):
    return sum(rec[k] for k in _TOTAL_PARTS)


def _check_total(rec, claimed):
    """Set rec['total'] from the parts, noting any disagreement.

    Returns nothing; annotates rec. `claimed` is the provider's own
    total_tokens, or 0/None when it does not report one.
    """
    rec["total"] = derived_total(rec)
    if not claimed:
        return
    # Known and expected: a provider whose total omits the cache buckets.
    cache = rec["cached"] + rec["cache_write"]
    if claimed == rec["total"] or claimed == rec["total"] - cache:
        return
    # Anything else means the provider changed what it reports. Say so,
    # with both numbers, instead of printing one of them as fact.
    rec["note"] = f"provider total {claimed} != parts {rec['total']}"


def _codex_sessions(since):
    """Read codex rollout logs.

    thread_token_usage is cumulative over the session, so the LAST record is
    the session total — summing records would multiply-count every turn.
    """
    out = []
    for path in glob.glob(os.path.join(HOME, ".codex", "sessions", "**", "rollout-*.jsonl"),
                          recursive=True):
        mtime = os.path.getmtime(path)
        if since and mtime < since:
            continue
        rec = _blank("codex", "", os.path.basename(path))
        rec["mtime"] = mtime
        # The provider's own figure, for _check_total to compare against. A
        # session log may carry neither record, so it starts at 0 ("no claim").
        claimed = 0
        for d in _f(path):
            t = d.get("type")
            p = d.get("payload") or {}
            if t == "session_meta":
                rec["cwd"] = p.get("cwd", "")
                rec["session"] = p.get("session_id", rec["session"])
            elif t == "turn_context":
                rec["model"] = p.get("model", rec["model"]) or rec["model"]
            elif t == "token_usage_record":
                u = p.get("thread_token_usage") or {}
                if u:
                    rec["input"] = u.get("input_tokens", 0)
                    rec["output"] = u.get("output_tokens", 0)
                    rec["cached"] = u.get("cached_input_tokens", 0)
                    rec["reasoning"] = u.get("reasoning_output_tokens", 0)
                    claimed = u.get("total_tokens", 0)
                last = p.get("usage") or {}
                if last:
                    rec["last_total"] = last.get("total_tokens", rec["last_total"])
            elif t == "event_msg" and p.get("type") == "token_count":
                info = p.get("info") or {}
                if info.get("model_context_window"):
                    rec["context_window"] = info["model_context_window"]
                tot = info.get("total_token_usage") or {}
                if tot.get("total_tokens"):
                    claimed = max(claimed, tot["total_tokens"])
                rl = p.get("rate_limits") or {}
                if rl:
                    rec["plan"] = rl.get("plan_type") or rec["plan"]
                    rec["quota"] = _codex_quota(rl)
        _check_total(rec, claimed)
        if rec["total"]:
            out.append(rec)
    return out


def _codex_quota(rl):
    """Percent of plan quota USED, when codex states it.

    The shape varies by plan: `primary`/`secondary` windows carry
    used_percent + a reset time; on some plans both are null and only credits
    are present. Returning None means "codex did not say", which is reported
    as unknown instead of as 0%.
    """
    for key in ("primary", "secondary", "individual_limit"):
        w = rl.get(key)
        if isinstance(w, dict):
            pct = w.get("used_percent")
            if pct is None:
                pct = w.get("used_percentage")
            if pct is not None:
                return {
                    "window": key,
                    "used_percent": pct,
                    "resets_in_seconds": w.get("resets_in_seconds"),
                }
    credits = rl.get("credits")
    if isinstance(credits, dict) and credits.get("unlimited"):
        return {"window": "credits", "used_percent": 0.0, "resets_in_seconds": None}
    return None


def _claude_sessions(since):
    """Read Claude Code transcripts.

    message.usage is PER MESSAGE, not cumulative, so these are summed. Cache
    reads are counted separately because they are the bulk of input tokens in
    a long session and billing treats them differently.
    """
    out = []
    for path in glob.glob(os.path.join(HOME, ".claude", "projects", "*", "*.jsonl")):
        mtime = os.path.getmtime(path)
        if since and mtime < since:
            continue
        slug = os.path.basename(os.path.dirname(path))
        rec = _blank("claude", "", os.path.basename(path)[:-6])
        rec["mtime"] = mtime
        rec["cwd"] = slug
        for d in _f(path):
            msg = d.get("message") or {}
            u = msg.get("usage") or {}
            if not u:
                continue
            if msg.get("model"):
                rec["model"] = msg["model"]
            rec["input"] += u.get("input_tokens", 0)
            rec["output"] += u.get("output_tokens", 0)
            rec["cached"] += u.get("cache_read_input_tokens", 0)
            rec["cache_write"] += u.get("cache_creation_input_tokens", 0)
            details = u.get("output_tokens_details") or {}
            rec["reasoning"] += details.get("thinking_tokens", 0)
            # Context held at this message: the whole input side plus the reply.
            # The PEAK matters, not the newest message — after a compaction the
            # newest message is small again, and reporting that as "context
            # used" would hide that the session ever filled up.
            held = (u.get("input_tokens", 0)
                    + u.get("cache_read_input_tokens", 0)
                    + u.get("cache_creation_input_tokens", 0)
                    + u.get("output_tokens", 0))
            rec["last_total"] = max(rec["last_total"], held)
        # input_tokens excludes cache, so the buckets are disjoint. Claude
        # states no per-session total of its own, hence no claim to check.
        _check_total(rec, 0)
        if rec["total"]:
            out.append(rec)
    return out


def _agy_usage(since, state):
    """Read antigravity usage that forge recorded from the headless envelope.

    `agy -p --output-format json` prints one envelope per run carrying
    usage={input_tokens, output_tokens, thinking_tokens, cache_read_tokens,
    total_tokens}; there is no durable per-turn log, so forge-run saves it to
    .forge/usage/<name>.json and this reads it back. Verified against agy
    1.4.11.

    agy's own total_tokens is input+output and excludes cache_read_tokens
    (measured across all four model families on 1.4.11: claude-sonnet-4-6,
    claude-opus-4-6-thinking, gemini-3.8-flash-high, gpt-oss-120b-medium —
    total == input+output in every sample, with cache up to 39918). forge
    therefore derives TOTAL from the parts via _check_total rather than
    trusting or patching that figure, and reports a note if a future version
    starts counting differently.

    thinking_tokens is already part of output_tokens, not additional to it
    (gemini-3.8-flash-high: output=55, thinking=54), so it is recorded for
    display only and never added into the total.
    """
    out = []
    if not state:
        return out
    for path in sorted(glob.glob(os.path.join(state, "usage", "*.json"))):
        mtime = os.path.getmtime(path)
        if since and mtime < since:
            continue
        try:
            with open(path, encoding="utf-8") as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if d.get("provider") != "antigravity":
            continue
        u = d.get("usage") or {}
        rec = _blank("antigravity", d.get("model") or "?",
                     os.path.basename(path)[:-5])
        rec["mtime"] = mtime
        rec["cwd"] = d.get("cwd", "")
        rec["input"] = u.get("input_tokens", 0)
        rec["output"] = u.get("output_tokens", 0)
        rec["cached"] = u.get("cache_read_tokens", 0)
        rec["reasoning"] = u.get("thinking_tokens", 0)
        _check_total(rec, u.get("total_tokens", 0) or 0)
        # One headless run is one turn, so the envelope's own figure IS the
        # context held — there is no earlier peak to compare against.
        rec["last_total"] = rec["input"] + rec["cached"] + rec["output"]
        if rec["total"]:
            out.append(rec)
    return out


def collect(root=None, all_scope=False, since_days=0):
    since = time.time() - since_days * 86400 if since_days else 0
    state = os.path.join(root, ".forge") if root else ""
    recs = _codex_sessions(since) + _claude_sessions(since) + _agy_usage(since, state)
    if not all_scope and root:
        recs = [r for r in recs if _in_scope(r, root)]
    for r in recs:
        if not r["context_window"]:
            r["context_window"] = CONTEXT_WINDOWS.get(_short_model(r["model"]), 0)
    recs.sort(key=lambda r: r["mtime"], reverse=True)
    return recs


def _short_model(model):
    """Map a full model id onto a CONTEXT_WINDOWS key.

    Claude transcripts carry ids like claude-opus-5-5; models.conf uses the
    alias (opus). Matching on the alias keeps one table for both.
    """
    m = (model or "").lower()
    # Longest key first: "agy-sonnet" must not be matched by "sonnet", which
    # would report a Google-credits worker as if it ran on the Claude plan.
    for key in sorted(CONTEXT_WINDOWS, key=len, reverse=True):
        if key in m:
            return key
    return m


def _display_model(model):
    """The name to show, which is not always the context-window key.

    _short_model deliberately collapses ids onto a window key; for display
    that would erase the distinction the operator needs most — agy-sonnet
    (Google credits) vs sonnet (Claude subscription) are the same model on
    two different bills.
    """
    return model or "unknown"


def _in_scope(rec, root):
    """Does this session belong to the repo at <root>?

    codex records a real cwd, which for a forge worker is the
    worktree, not the repo — so the repo's basename is matched as well.
    Claude Code records a path-slug directory name instead.
    """
    root = os.path.abspath(root)
    base = os.path.basename(root)
    cwd = rec.get("cwd") or ""
    if rec["provider"] == "claude":
        return cwd == "-" + root.replace("/", "-").lstrip("-") or base in cwd
    # An antigravity record is written BY this repo's forge into this repo's
    # .forge/usage, so it is in scope by construction — its cwd is the
    # worktree, which lives outside the repo.
    if rec["provider"] == "antigravity":
        return True
    if not cwd:
        return False
    return os.path.abspath(cwd).startswith(root) or ("/.forge-wt/" in cwd and base in cwd)


def _fmt(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}k"
    return str(n)


def _pct(used, total):
    """Percent of the context window held.

    Over 100% cannot happen physically, so it means CONTEXT_WINDOWS is wrong
    for this model: say so instead of printing a number that looks like fact.
    """
    if not total:
        return "    -"
    pct = 100.0 * used / total
    if pct > 100.0:
        return "  >100%?"
    return f"{pct:5.1f}%"


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--all", action="store_true",
                    help="every local session, not just this repo's")
    ap.add_argument("--since", type=float, default=0, metavar="DAYS")
    ap.add_argument("--root", default=os.environ.get("FORGE_USAGE_ROOT", ""))
    a = ap.parse_args()

    root = a.root or os.getcwd()
    recs = collect(root=root, all_scope=a.all, since_days=a.since)

    if a.json:
        json.dump(recs, sys.stdout, indent=1)
        print()
        return 0

    if not recs:
        scope = "any local session" if a.all else f"a session for {root}"
        print(f"no token usage found for {scope}.")
        print("Providers are read from ~/.codex/sessions, ~/.claude/projects "
              "and .forge/usage; run a worker first, or try --all.")
        return 0

    # Per model, because that is what the question "how much did this cost"
    # actually turns on — a provider total hides an expensive model.
    per = {}
    for r in recs:
        key = (r["provider"], _display_model(r["model"]))
        agg = per.setdefault(key, {"total": 0, "input": 0, "output": 0,
                                   "cached": 0, "reasoning": 0, "sessions": 0})
        for f in ("total", "input", "output", "cached", "reasoning"):
            agg[f] += r[f]
        agg["sessions"] += 1

    print(f"{'PROVIDER':11} {'MODEL':20} {'SESS':>4} {'TOTAL':>8} {'IN':>8} "
          f"{'OUT':>8} {'CACHED':>8} {'REASON':>8}")
    for (prov, model), agg in sorted(per.items(), key=lambda kv: -kv[1]["total"]):
        print(f"{prov:11} {model[:20]:20} {agg['sessions']:>4} {_fmt(agg['total']):>8} "
              f"{_fmt(agg['input']):>8} {_fmt(agg['output']):>8} "
              f"{_fmt(agg['cached']):>8} {_fmt(agg['reasoning']):>8}")

    print()
    print(f"{'PROVIDER':11} {'MODEL':20} {'CONTEXT USED':>13} {'PLAN QUOTA':>12}  SESSION")
    for r in recs[:15]:
        ctx = _pct(r["last_total"], r["context_window"])
        if r["quota"] and r["quota"].get("used_percent") is not None:
            q = f"{r['quota']['used_percent']:5.1f}% used"
        elif r["provider"] == "codex":
            q = "  not stated"
        else:
            q = "         n/a"
        print(f"{r['provider']:11} {_display_model(r['model'])[:20]:20} {ctx:>13} "
              f"{q:>12}  {r['session'][:20]}")

    # A disagreement between the provider's total and the parts means the CLI
    # changed what it reports. That invalidates the TOTAL column, so it is
    # stated loudly rather than left in a JSON field nobody reads.
    notes = sorted({r["note"] for r in recs if r.get("note")})
    if notes:
        print()
        print("WARNING: a provider's reported total no longer matches its own "
              "parts, so TOTAL may be wrong:")
        for n in notes:
            print(f"  {n}")
        print("  TOTAL is the sum of in+out+cache; please re-check the "
              "provider's usage format.")

    if any(r["provider"] == "codex" and not r["quota"] for r in recs):
        print()
        print("note: 'not stated' means codex returned no quota window for that "
              "session (common on plans that report credits only).")
    if not any(r["provider"] == "antigravity" for r in recs):
        print("note: no antigravity usage recorded yet — it is written only when "
              "a worker runs on an agy model (see forge-models).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
