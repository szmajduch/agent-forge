#!/usr/bin/env python3
"""forge-dashboard --root <repo> [--port 8787] [--host 127.0.0.1]

Live status page for forge workers + a feedback box for operator/client.
Binds to localhost; expose it with Cloudflare Tunnel (see forge-up).

If FORGE_DASH_TOKEN is set, every request needs ?t=<token> (the page keeps it
in the URL) or header X-Forge-Token. ALWAYS set it before exposing via tunnel.
Set FORGE_DASH_LOGS=0 to hide raw worker logs from viewers (recommended for clients).

FORGE_DASH_ACTIONS=1 adds buttons that run forge-cancel / forge-merge /
forge-retry. Off by default, because the page is built to be shared and those
change the repository.

The gate is the operator's opt-in, NOT the client's address. Measured
2026-10-30: `cloudflared tunnel --url http://127.0.0.1:<port>` is a reverse
proxy on the same host, so a tunnel visitor arrives with
client_address == "127.0.0.1", indistinguishable from the operator at their own
terminal. X-Forwarded-For does arrive but anyone who can reach the port can set
it, so it is usable for rate-limit buckets and never for authorization. A
"localhost only" check would therefore be a hole in exactly the case it exists
for; with FORGE_DASH_ACTIONS=1 and a tunnel, anyone holding the URL (and the
token, if set) can act — forge-up warns about that at startup.
"""
import argparse
import glob
import importlib.machinery
import importlib.util
import hmac
import json
import os
import re
import subprocess
import sys
import threading
import time
import socketserver
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

# forge-usage holds the per-provider token parsers. It is imported rather than
# reimplemented, so the dashboard and the CLI can never disagree about what a
# number means. It has no .py extension, hence the explicit loader.
def _load_usage_module():
    import importlib.util
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "forge-usage")
    try:
        loader = importlib.machinery.SourceFileLoader("forge_usage", path)
        spec = importlib.util.spec_from_loader("forge_usage", loader)
        mod = importlib.util.module_from_spec(spec)
        # Do not leave a __pycache__ next to the scripts: bin/ holds commands,
        # and a stray cache directory shows up as untracked noise in the repo.
        old = sys.dont_write_bytecode
        sys.dont_write_bytecode = True
        try:
            loader.exec_module(mod)
        finally:
            sys.dont_write_bytecode = old
        return mod
    except Exception:
        return None


ap = argparse.ArgumentParser()
ap.add_argument("--root", required=True)
ap.add_argument("--port", type=int, default=8787)
ap.add_argument("--host", default="127.0.0.1")
args = ap.parse_args()

ROOT = os.path.abspath(args.root)
STATE = os.path.join(ROOT, ".forge")
TOKEN = os.environ.get("FORGE_DASH_TOKEN", "")
SHOW_LOGS = os.environ.get("FORGE_DASH_LOGS", "1") != "0"
ACTIONS = os.environ.get("FORGE_DASH_ACTIONS", "0") == "1"
BIN = os.path.dirname(os.path.abspath(__file__))

# Each action maps to the command that already implements it, with the status
# values that command accepts. The dashboard decides nothing about safety: it
# shells out, and forge-cancel/-merge/-retry refuse what they always refuse, so
# there is one rule per operation instead of two that can drift apart.
#
# forge-drop is deliberately absent. It discards a worktree and branch
# irreversibly, which is not something to put behind a button on a page built
# to be shared.
ACTION_CMDS = {
    "cancel": ("forge-cancel", ("queued", "running")),
    "merge":  ("forge-merge", ("done", "cancelled", "nochanges")),
    "retry":  ("forge-retry", ("failed", "exhausted", "nochanges", "cancelled")),
}
ACTION_TIMEOUT = 120  # forge-merge can take a while on a large tree
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
FEEDBACK_MAX_BYTES = 1_000_000
FEEDBACK_KEEP = 500          # entries retained when the file is trimmed
FEEDBACK_MIN_INTERVAL = 2.0  # seconds between posts from one address

# Keyed by caller (see rate_limit_key), not by socket address: behind a tunnel
# every visitor shares one socket address, so bucketing on it would make two
# people posting at once block each other.
#
# Bounded and locked: the server is threaded, so two POSTs can read-modify-write
# this at the same time, and a dict that only ever grows is a slow leak in a
# process meant to run for days.
_last_post = {}
_last_post_lock = threading.Lock()
RATE_BUCKETS_MAX = 4096


def git(*a):
    try:
        return subprocess.run(["git", "-C", ROOT, *a], capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return ""


# Every open tab polls /api/state every 3s, and each agent costs two git
# subprocesses per poll. The answer only changes when a worker rewrites its
# JSON, so the newest mtime under .forge/agents is a sufficient cache key.
_CACHE = {"key": None, "value": None, "at": 0.0}
_CACHE_TTL = 2.0


def state_cache_key():
    try:
        newest = max(
            (os.path.getmtime(p) for p in glob.glob(os.path.join(STATE, "agents", "*.json"))),
            default=0.0,
        )
    except OSError:
        newest = 0.0
    try:
        fb = os.path.getmtime(os.path.join(STATE, "feedback.jsonl"))
    except OSError:
        fb = 0.0
    return (newest, fb, git("rev-parse", "HEAD"))


_USAGE_MOD = None
_USAGE_CACHE = {"value": None, "at": 0.0}
_USAGE_TTL = 30.0

_PLAN_MOD = None
# The plan reading lives here, refreshed by a background thread, and a request
# only ever reads it. That is not a nicety: a reading STARTS PROVIDER
# PROCESSES, measured at 4.5-5.9s for claude -p plus agy -p together, and it
# used to run inside the request path. One /api/state in every cache period
# therefore blocked for ~6s while the page kept polling every 3s. Measured on
# a real dashboard: 5.886s cold, 0.030s warm — a 200x difference that the
# operator saw as the page freezing.
_PLAN_CACHE = {"value": None, "at": 0.0, "reading": False}
_PLAN_LOCK = threading.Lock()

# How often the thread re-reads, by whether there is anything to see. Plan
# windows are 5 hours and a week and the percentages are whole numbers, so
# nothing moves while no worker is running — but while one is, the figure does
# change from minute to minute and that is exactly when it is worth watching.
_PLAN_INTERVAL_BUSY = float(os.environ.get("FORGE_PLAN_INTERVAL", "30"))
_PLAN_INTERVAL_IDLE = float(os.environ.get("FORGE_PLAN_INTERVAL_IDLE", "300"))

# Written so forge-plan in a terminal can reuse a fresh reading instead of
# starting the CLIs again, and so the figures survive a dashboard restart.
PLAN_CACHE_FILE = os.path.join(STATE, "usage", "plan.json")


def _plan_mod():
    """forge-plan imported as a module, once."""
    global _PLAN_MOD
    if _PLAN_MOD is None:
        loader = importlib.machinery.SourceFileLoader(
            "forge_plan", os.path.join(BIN, "forge-plan"))
        spec = importlib.util.spec_from_loader("forge_plan", loader)
        mod = importlib.util.module_from_spec(spec)
        argv = sys.argv
        sys.argv = ["forge-plan"]
        try:
            loader.exec_module(mod)
        finally:
            sys.argv = argv
        _PLAN_MOD = mod
    return _PLAN_MOD


def _plan_read_now():
    """Read every provider. Slow by nature — only the thread calls this."""
    value = {"providers": {}, "read_at": int(time.time())}
    try:
        mod = _plan_mod()
        for prov, r in mod.read_all().items():
            value["providers"][prov] = {
                "plan": r.get("plan") or "",
                "from_disk": bool(r.get("from_disk")),
                "read_at": r.get("read_at"),
                "windows": [
                    {"window": w["window"], "family": w.get("family"),
                     "left": w["left_percent"],
                     "reset": mod.fmt_reset(w)}
                    for w in r["windows"]],
            }
    except Exception as e:
        value["error"] = f"{type(e).__name__}: {e}"
    return value


def _workers_running():
    """True when any agent is queued or running.

    Read from the state files rather than from the cached page state, so the
    thread does not depend on anyone having loaded the page.
    """
    try:
        for path in glob.glob(os.path.join(STATE, "agents", "*.json")):
            try:
                with open(path, encoding="utf-8") as f:
                    if (json.load(f) or {}).get("status") in ("queued",
                                                              "running"):
                        return True
            except (OSError, ValueError):
                continue
    except OSError:
        pass
    return False


def _plan_store(value):
    with _PLAN_LOCK:
        _PLAN_CACHE.update(value=value, at=time.monotonic())
    # Best effort: the figures are useful in memory even if the file cannot be
    # written (a read-only checkout, a repo without .forge yet).
    try:
        os.makedirs(os.path.dirname(PLAN_CACHE_FILE), exist_ok=True)
        tmp = PLAN_CACHE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(value, f, indent=1)
        os.replace(tmp, PLAN_CACHE_FILE)   # atomic: a reader never sees half
    except OSError:
        pass


def _plan_load_from_disk():
    """Seed the cache from the last run, so a restart is not blank."""
    try:
        with open(PLAN_CACHE_FILE, encoding="utf-8") as f:
            value = json.load(f)
    except (OSError, ValueError):
        return
    if isinstance(value, dict) and value.get("providers"):
        with _PLAN_LOCK:
            if _PLAN_CACHE["value"] is None:
                _PLAN_CACHE.update(value=value, at=time.monotonic())


def plan_refresher():
    """Keep _PLAN_CACHE current. Runs as a daemon thread for the server's life.

    Never raises: a failed reading leaves the previous one in place, with its
    own read_at, so the page can say how old it is instead of going blank.

    The wait is broken into short slices and the worker check happens in every
    one of them. A single sleep of the idle interval was wrong, and measurably
    so: a worker spawned a second into a 300s idle sleep ran for 20 seconds,
    failed, and the thread never noticed — it woke up 300s later to find
    nothing running and slept again. The busy interval could not take effect
    during the only period it was meant for. Re-checking every few seconds
    costs one glob of .forge/agents, no process at all.
    """
    while True:
        try:
            _plan_store(_plan_read_now())
        except Exception:
            pass
        # Slice short enough to catch a worker that lives a few seconds, and
        # never longer than the busy interval itself.
        slice_s = min(5.0, max(1.0, _PLAN_INTERVAL_BUSY))
        waited = 0.0
        while True:
            target = (_PLAN_INTERVAL_BUSY if _workers_running()
                      else _PLAN_INTERVAL_IDLE)
            if waited >= target:
                break
            step = min(slice_s, target - waited)
            time.sleep(step)
            waited += step


def plan_summary():
    """Whatever the refresher last read. Never starts a process, never blocks.

    A request must not wait on a provider CLI, so this returns the cache as it
    is — including the "not read yet" state during the first few seconds after
    startup, which the page shows as such rather than as "no quota".
    """
    if os.environ.get("FORGE_DASH_PLAN", "1") != "1":
        return {"off": True, "reason": "FORGE_DASH_PLAN=0"}
    with _PLAN_LOCK:
        value = _PLAN_CACHE["value"]
    if value is None:
        return {"pending": True}
    return value


def usage_summary():
    """Token usage per provider+model, plus the live sessions' context/quota.

    Scanning every local session log is far too expensive for the 3s poll, so
    this is cached for _USAGE_TTL and the page reuses whatever is current.
    """
    global _USAGE_MOD
    now = time.monotonic()
    if _USAGE_CACHE["value"] is not None and now - _USAGE_CACHE["at"] < _USAGE_TTL:
        return _USAGE_CACHE["value"]
    if _USAGE_MOD is None:
        _USAGE_MOD = _load_usage_module()
    value = {"models": [], "sessions": [], "error": ""}
    if _USAGE_MOD is None:
        value["error"] = "forge-usage not found next to forge-dashboard"
    else:
        try:
            recs = _USAGE_MOD.collect(root=ROOT, all_scope=False, since_days=0)
            per = {}
            for r in recs:
                key = (r["provider"], _USAGE_MOD._display_model(r["model"]))
                agg = per.setdefault(key, {"provider": key[0], "model": key[1],
                                           "total": 0, "input": 0, "output": 0,
                                           "cached": 0, "sessions": 0})
                for f in ("total", "input", "output", "cached"):
                    agg[f] += r[f]
                agg["sessions"] += 1
            value["models"] = sorted(per.values(), key=lambda a: -a["total"])
            for r in recs[:8]:
                win = r["context_window"]
                held = r["last_total"]
                pct = round(100.0 * held / win, 1) if win and held <= win else None
                # No per-session quota here. Plan quota is ONE account-wide
                # pool, so printing it in a per-session row showed the same
                # pool as "1.0% used" beside "67.0% used" — those were
                # readings of different ages, not different allowances. It
                # now lives in plan_summary(), read once, newest wins.
                value["sessions"].append({
                    "provider": r["provider"],
                    "model": _USAGE_MOD._display_model(r["model"]),
                    "session": r["session"][:20],
                    "context_pct": pct,
                    "context_window": win,
                })
        except Exception as e:
            value["error"] = f"{type(e).__name__}: {e}"
    _USAGE_CACHE.update(value=value, at=now)
    return value


def tail(path, n=40):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 64_000))
            lines = f.read().decode("utf-8", "replace").splitlines()[-n:]
        return ANSI.sub("", "\n".join(lines))
    except FileNotFoundError:
        return ""


def state():
    """Cached snapshot. The TTL bounds how stale a reply can be even while
    workers write continuously; the key makes a real change show up at once."""
    now = time.monotonic()
    if _CACHE["value"] is not None and now - _CACHE["at"] < _CACHE_TTL:
        key = state_cache_key()
        if key == _CACHE["key"]:
            return _CACHE["value"]
    value = build_state()
    _CACHE.update(key=state_cache_key(), value=value, at=now)
    return value


def build_state():
    agents = []
    for p in sorted(glob.glob(os.path.join(STATE, "agents", "*.json"))):
        try:
            a = json.load(open(p))
        except Exception:
            continue
        name, base, br = a.get("name", ""), a.get("base_sha", ""), a.get("branch", "")
        if a.get("status") not in ("merged", "dropped") and base and br:
            a["commits"] = git("log", "--oneline", "-8", f"{base}..{br}").splitlines()
            a["diffstat"] = git("diff", "--shortstat", f"{base}...{br}")
        a["log"] = tail(os.path.join(STATE, "logs", f"{name}.log")) if SHOW_LOGS else ""
        agents.append(a)
    # exhausted ranks beside failed: both need the operator, but an
    # exhausted worker needs only a later retry, not a new brief.
    order = {"running": 0, "queued": 1, "conflict": 2, "failed": 3,
             "exhausted": 4, "done": 5, "cancelled": 6, "nochanges": 7,
             "merged": 8, "dropped": 9}
    agents.sort(key=lambda a: (order.get(a.get("status"), 9), a.get("created", "")))
    feedback = []
    try:
        with open(os.path.join(STATE, "feedback.jsonl")) as f:
            feedback = [json.loads(l) for l in f if l.strip()][-50:]
    except FileNotFoundError:
        pass
    return {
        "repo": os.path.basename(ROOT),
        "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
        "head": git("log", "--oneline", "-6"),
        "agents": agents,
        "usage": usage_summary(),
        "plan": plan_summary(),
        "feedback": feedback,
        "logs": SHOW_LOGS,
        "actions": ACTIONS,
        "now": time.strftime("%Y-%m-%d %H:%M:%S"),
    }


class H(BaseHTTPRequestHandler):
    server_version = "forge"

    def log_message(self, *a):
        pass

    def authed(self):
        """The only access check. It rests on the token and nothing else.

        Deliberately ignores where the request appears to come from: behind a
        tunnel every visitor arrives as 127.0.0.1, and the forwarded-for headers
        that do carry the real address are caller-settable. Neither can gate
        anything. rate_limit_key() uses those headers because a forged value
        there harms only the forger.
        """
        if not TOKEN:
            return True
        q = parse_qs(urlparse(self.path).query).get("t", [""])[0]
        h = self.headers.get("X-Forge-Token", "")
        return hmac.compare_digest(q, TOKEN) or hmac.compare_digest(h, TOKEN)

    def send(self, code, body, ctype="application/json"):
        b = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if not self.authed():
            return self.send(401, "unauthorized — add ?t=<token>", "text/plain")
        path = urlparse(self.path).path
        if path == "/":
            return self.send(200, PAGE, "text/html")
        if path == "/api/state":
            return self.send(200, json.dumps(state()))
        self.send(404, "not found", "text/plain")

    def rate_limit_key(self):
        """Who to count this POST against.

        The socket address is the wrong answer behind a tunnel: forge-up runs
        `cloudflared tunnel --url http://127.0.0.1:<port>`, so cloudflared is a
        reverse proxy on this host and every visitor arrives as 127.0.0.1. One
        shared bucket means two clients posting at once block each other, and
        one client in a loop blocks everyone.

        So a forwarded-for header is preferred when present. These headers are
        attacker-settable — anyone who can reach the port can write any value —
        which is exactly why they are used HERE and nowhere else: forging one
        only splits your own bucket, costing you nothing and gaining you
        nothing, whereas trusting one for access control would hand out the
        dashboard. Never use this for authorization; see authed().
        """
        for h in ("Cf-Connecting-Ip", "X-Real-Ip", "X-Forwarded-For"):
            v = self.headers.get(h, "")
            if v:
                # X-Forwarded-For is a chain, "client, proxy1, proxy2"; the
                # original client is the first entry.
                first = v.split(",")[0].strip()
                # Cap it: the value is caller-controlled and becomes a dict key.
                if first:
                    return first[:64]
        return self.client_address[0]

    def take_rate_token(self):
        """True if this caller may post now, recording the attempt if so."""
        who = self.rate_limit_key()
        now = time.monotonic()
        with _last_post_lock:
            if now - _last_post.get(who, 0.0) < FEEDBACK_MIN_INTERVAL:
                return False
            # Bounded: the keys are caller-supplied, so without this a stream of
            # distinct X-Forwarded-For values would grow the dict forever. Drop
            # entries that are already past the window, and if that frees
            # nothing (every bucket is live), drop the oldest.
            if len(_last_post) >= RATE_BUCKETS_MAX:
                cutoff = now - FEEDBACK_MIN_INTERVAL
                for k in [k for k, t in _last_post.items() if t < cutoff]:
                    del _last_post[k]
                while len(_last_post) >= RATE_BUCKETS_MAX:
                    del _last_post[min(_last_post, key=_last_post.get)]
            _last_post[who] = now
            return True

    def run_action(self, body):
        """POST /api/action — run one forge command for one agent.

        Everything that decides whether an action is allowed lives in the
        command being run; this validates only the shape of the request, so the
        page cannot talk the dashboard into something the CLI would refuse.
        """
        if not ACTIONS:
            return self.send(403, '{"error":"actions are disabled '
                                  '(start the dashboard with FORGE_DASH_ACTIONS=1)"}')
        try:
            d = json.loads(body)
        except Exception:
            return self.send(400, '{"error":"bad request"}')
        action = str(d.get("action", ""))
        name = str(d.get("agent", ""))
        if action not in ACTION_CMDS:
            return self.send(400, json.dumps(
                {"error": "unknown action", "allowed": sorted(ACTION_CMDS)}))
        # The name becomes an argv entry, so it is matched against the same
        # shape forge's own valid_name accepts rather than merely escaped.
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,39}", name):
            return self.send(400, '{"error":"invalid agent name"}')

        cmd, allowed = ACTION_CMDS[action]
        agents = {a.get("name"): a for a in state()["agents"]}
        if name not in agents:
            return self.send(404, '{"error":"no such agent"}')
        status = agents[name].get("status", "")
        if status not in allowed:
            return self.send(409, json.dumps(
                {"error": "%s is '%s'; %s applies to %s"
                          % (name, status, action, "/".join(allowed))}))

        argv = [os.path.join(BIN, cmd), name]
        try:
            # cwd=ROOT because every forge command locates the repo from the
            # working directory. No shell: argv is passed through as a list.
            p = subprocess.run(argv, cwd=ROOT, capture_output=True, text=True,
                               timeout=ACTION_TIMEOUT)
            out = ((p.stdout or "") + (p.stderr or "")).strip()[-4000:]
            rc = p.returncode
        except subprocess.TimeoutExpired:
            out, rc = "timed out after %ss" % ACTION_TIMEOUT, 124
        except Exception as e:
            out, rc = "%s: %s" % (type(e).__name__, e), 1
        # The cached snapshot predates the action, so the next poll must rebuild
        # it or the page would show the old status and look broken.
        _CACHE["value"] = None
        return self.send(200 if rc == 0 else 500,
                         json.dumps({"ok": rc == 0, "action": action,
                                     "agent": name, "exit_code": rc,
                                     "output": out}))

    def do_POST(self):
        if not self.authed():
            return self.send(401, '{"error":"unauthorized"}')
        path = urlparse(self.path).path
        if path == "/api/action":
            n = min(int(self.headers.get("Content-Length", 0)), 20_000)
            return self.run_action(self.rfile.read(n))
        if path != "/api/feedback":
            return self.send(404, '{"error":"not found"}')
        # One note every couple of seconds per caller is plenty for a human and
        # stops a loop from filling the disk.
        if not self.take_rate_token():
            return self.send(429, '{"error":"too many requests"}')
        try:
            n = min(int(self.headers.get("Content-Length", 0)), 20_000)
            d = json.loads(self.rfile.read(n))
            text = str(d.get("text", "")).strip()[:4000]
            if not text:
                return self.send(400, '{"error":"empty"}')
            entry = {
                "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
                "author": str(d.get("author", "") or "anonymous").strip()[:60],
                "agent": re.sub(r"[^a-z0-9-]", "", str(d.get("agent", "")))[:40],
                "text": text,
            }
            os.makedirs(STATE, exist_ok=True)
            path = os.path.join(STATE, "feedback.jsonl")
            # The endpoint is reachable by anyone holding the URL, so the file
            # must not grow without bound. Keep the newest entries only.
            with open(path, "a") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
            try:
                if os.path.getsize(path) > FEEDBACK_MAX_BYTES:
                    with open(path) as f:
                        kept = f.readlines()[-FEEDBACK_KEEP:]
                    with open(path, "w") as f:
                        f.writelines(kept)
            except OSError:
                pass
            self.send(200, '{"ok":true}')
        except Exception:
            self.send(400, '{"error":"bad request"}')


PAGE = r"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Forge</title>
<style>
:root{--bg:#f4f2ee;--panel:#fffdf9;--ink:#1d1b18;--mute:#6f6a62;--line:#e2ddd4;
