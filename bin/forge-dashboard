const T=new URLSearchParams(location.search).get('t')||'';
const q=p=>p+(T?(p.includes('?')?'&':'?')+'t='+encodeURIComponent(T):'');
const C={running:'--run',queued:'--idle',done:'--ok',merged:'--ok',failed:'--bad',exhausted:'--warn',conflict:'--warn',cancelled:'--warn',nochanges:'--idle',dropped:'--idle'};
const el=(t,cls,txt)=>{const e=document.createElement(t);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e};
const open=new Set();
const fmtTok=n=>n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e3?(n/1e3).toFixed(1)+'k':String(n);
function renderUsage(u){
  const box=document.getElementById('usage');box.textContent='';
  if(!u){box.appendChild(el('div','sub','—'));return}
  if(u.error){box.appendChild(el('div','sub',u.error));return}
  if(!u.models.length){box.appendChild(el('div','sub','no usage recorded yet'));return}
  box.appendChild(el('div','uh','per model'));
  for(const m of u.models){
    const r=el('div','u');
    r.appendChild(el('span','',m.provider+' '+m.model));
    r.appendChild(el('b','',fmtTok(m.total)));
    box.appendChild(r);
  }
  if(u.sessions.length){
    box.appendChild(el('div','uh','context held, per session'));
    for(const sx of u.sessions){
      const r=el('div','u');
      r.appendChild(el('span','',sx.provider+' '+(sx.model||'?')));
      // A null percentage means the context window was not stated: say so
      // rather than drawing a bar that implies a measurement.
      r.appendChild(el('span','m',sx.context_pct!=null?sx.context_pct+'%':'n/a'));
      box.appendChild(r);
      if(sx.context_pct>0){
        const p=sx.context_pct;
        const b=el('div','bar'+(p>=85?' hi':p>=60?' mid':''));
        const i=el('i');i.style.width=Math.min(100,p)+'%';b.appendChild(i);box.appendChild(b);
      }
    }
  }
}

// How much of each plan is LEFT. Separate from renderUsage because it answers
// a different question: tokens say what was spent, this says what remains.
// The bar fills with what is left, and goes red when LITTLE is left — the
// opposite sense to the context bars above, which fill as they get worse.
function renderPlan(p){
  const box=document.getElementById('plan');
  box.replaceChildren();
  if(!p||p.off){
    box.appendChild(el('div','m','off'));
    return;
  }
  if(p.error){box.appendChild(el('div','m','could not read: '+p.error));return}
  const provs=Object.keys(p.providers||{});
  if(!provs.length){
    box.appendChild(el('div','m','no plan quota reported — no provider CLI '
      +'is signed in, or none has run yet'));
    return;
  }
  for(const name of ['claude','codex','antigravity']){
    const r=p.providers[name];
    if(!r)continue;
    let head=name+(r.plan?' ('+r.plan+')':'');
    box.appendChild(el('div','uh',head));
    if(r.from_disk){
      // codex is read from its own session files, not asked now. Without
      // this the page would present a day-old number as current.
      box.appendChild(el('div','m','from its last session, not read live'));
    }
    for(const w of r.windows){
      const label=(w.family?w.family+' ':'')+w.window;
      const row=el('div','u');
      row.appendChild(el('span','',label));
      row.appendChild(el('b','',w.left+'% left'));
      box.appendChild(row);
      const b=el('div','bar'+(w.left<=15?' hi':w.left<=40?' mid':''));
      const i=el('i');i.style.width=Math.max(0,Math.min(100,w.left))+'%';
      b.appendChild(i);box.appendChild(b);
      if(w.reset)box.appendChild(el('div','m','resets '+w.reset));
    }
  }
  // How old the figures are. With a background refresher a stale reading
  // looks exactly like a fresh one, so the age is shown — and called out
  // when it is old enough to mean the refresher itself stopped.
  if(p.read_at){
    const age=Math.max(0,Math.round(Date.now()/1000-p.read_at));
    box.appendChild(el('div','m','read '+(age<90?age+'s':Math.round(age/60)+'m')+' ago'
      +(age>600?' — refresher may have stopped':'')));
  }
  if(p.error)box.appendChild(el('div','m','last read failed: '+p.error));
  if(p.providers.antigravity&&p.providers.claude){
    box.appendChild(el('div','m',"antigravity's ‘Claude and GPT models’ "
      +'is its own pool, not your Claude subscription'));
  }
}
