  b.disabled=false;document.getElementById('sent').textContent=r.ok?'sent':'failed';if(r.ok){t.value='';load()}};
load();setInterval(load,3000);
</script></body></html>"""

class Server(ThreadingHTTPServer):
    """ThreadingHTTPServer that does not consult DNS to start.

    http.server.HTTPServer.server_bind() calls socket.getfqdn(host) after
    bind() to fill in self.server_name, i.e. it does a REVERSE DNS lookup
    during startup. The result is only ever used to populate the CGI variable
    SERVER_NAME, which this dashboard never reads.

    On a resolver that does not answer for 127.0.0.1 that lookup blocks, and
    it blocks in the worst possible place: after the listening socket exists
    but before serve_forever() runs. A client then connects successfully to a
    kernel backlog that nothing is accepting from, so it does not get
    "connection refused" — it hangs until its own timeout. Measured on the
    macOS GitHub runner: ten dashboards in a row never answered, every one
    reporting `port accepting: False` and `urlopen error timed out`, with the
    process alive and nothing printed. Reproduced exactly by making getfqdn
    sleep; the names resolve in 0.01s on a normal machine, which is why this
    never showed up locally or on ubuntu.

    So server_name is set without asking the network. Startup no longer
    depends on a resolver being reachable, here or on a user's laptop on a
    captive-portal network.
    """

    def server_bind(self):
        # TCPServer's bind, deliberately not HTTPServer's: that is the one
        # with the getfqdn call. Skipping a parent's override is unusual
        # enough to be worth saying out loud.
        socketserver.TCPServer.server_bind(self)
        host, port = self.server_address[:2]
        self.server_name = host
        self.server_port = port


if __name__ == "__main__":
    srv = Server((args.host, args.port), H)
    if os.environ.get("FORGE_DASH_PLAN", "1") == "1":
        # daemon=True on purpose: the refresher must not outlive the server.
        # Kill the dashboard — Ctrl-C, closing its tmux window, pkill — and
        # this thread goes with the process, leaving no orphan that keeps
        # calling provider CLIs for a dashboard nobody is running. It is also
        # why the loop needs no shutdown handshake: there is nothing to stop.
        _plan_load_from_disk()      # show the last known figures immediately
        threading.Thread(target=plan_refresher, daemon=True,
                         name="forge-plan-refresher").start()
        print("plan: refreshing every %gs while workers run, %gs when idle"
              % (_PLAN_INTERVAL_BUSY, _PLAN_INTERVAL_IDLE))
    print(f"forge dashboard: http://{args.host}:{args.port}" + (" (token required)" if TOKEN else ""))
    # Flushed because these lines are the only startup confirmation the
    # operator gets, and Python buffers stdout whenever it is not a terminal
    # — a redirected log or a piped tmux pane would hold them until the
    # process dies, i.e. exactly when they are no longer useful.
    sys.stdout.flush()
    if ACTIONS:
        print("actions ENABLED: cancel / merge / retry run from the page")
        # The action gate is the opt-in, not the address, so a tunnel makes
        # these reachable by whoever holds the URL. Said at startup, every
        # time, because FORGE_DASH_ACTIONS is the kind of variable that stays
        # exported in a shell long after the session it was meant for.
        if os.environ.get("FORGE_TUNNEL") == "1":
            print("  WARNING: a tunnel is configured. Anyone with the URL"
                  + (" and token" if TOKEN else " (and there is NO token)")
                  + " can cancel and merge your workers.")
        elif not TOKEN:
            print("  note: no FORGE_DASH_TOKEN — anyone who can reach this"
                  " port can act")
    srv.serve_forever()
