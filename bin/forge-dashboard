const ACTS={cancel:['queued','running'],merge:['done','cancelled','nochanges'],
            retry:['failed','exhausted','nochanges','cancelled']};
let ACTIONS_ON=false;
function actions(a){
  const avail=Object.keys(ACTS).filter(k=>ACTS[k].includes(a.status));
  if(!avail.length)return null;
  const box=el('div','acts'),msg=el('span','msg');
  for(const act of avail){
    const b=el('button',null,act);
    b.onclick=async()=>{
      // merge rewrites the main branch and retry spends tokens, so neither
      // fires on a single stray click.
      if(!confirm(act+' '+a.name+'?'))return;
      const all=box.querySelectorAll('button');
      all.forEach(x=>x.disabled=true);
      msg.className='msg';msg.textContent=act+'…';
      try{
        const r=await fetch(q('/api/action'),{method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({action:act,agent:a.name})});
        const j=await r.json().catch(()=>({}));
        msg.className='msg '+(r.ok?'good':'bad');
        // The command's own stdout/stderr, so a refusal explains itself here
        // instead of sending the operator to the terminal.
        msg.textContent=j.output||j.error||(r.ok?'done':'failed');
      }catch(e){msg.className='msg bad';msg.textContent=String(e)}
      all.forEach(x=>x.disabled=false);
      load();
    };
    box.append(b);
  }
  box.append(msg);
  return box;
}
function card(a){
  const c=el('div','card '+a.status);c.style.setProperty('--c','var('+(C[a.status]||'--idle')+')');
  const top=el('div','top');top.append(el('span','name',a.name));
