#!/usr/bin/env bash
# forge-up [-d]   — run from your project repo.
# Starts tmux session "forge" with:
#   orchestrator : Claude Code in the repo root
#   dashboard    : status page on 127.0.0.1:$FORGE_DASH_PORT (default 8787)
#   tunnel       : cloudflared tunnel     (only if FORGE_TUNNEL=1)
# -d : don't attach.
#
# Mouse support is left OFF on purpose; FORGE_MOUSE=on turns it on. See the
# comment at the set-option below — with it on, the wheel stops working in the
# orchestrator window.
source "$(dirname "$0")/forge-lib.sh" || exit 1
attach=1; [[ "${1:-}" == "-d" ]] && attach=0
port="${FORGE_DASH_PORT:-8787}"

# Validated here rather than at the set-option below: tmux exits 1 on a bad
# value, which under `set -e` would abort forge-up with the session already
# created but only half configured.
mouse="${FORGE_MOUSE:-off}"
case "$mouse" in
  on|off) ;;
  *) die "FORGE_MOUSE must be 'on' or 'off', got '$mouse'" ;;
esac

if tmux has-session -t "$FORGE_SESSION" 2>/dev/null; then
  info "session '$FORGE_SESSION' already exists"
else
  # The orchestrator model is configurable, but only among models.conf entries
  # whose role allows it — a worker-only model as orchestrator would start a
  # session that cannot drive the others.
  orch_cmd="${FORGE_ORCH_CMD:-}"
  if [[ -z "$orch_cmd" ]]; then
    orch_model="${FORGE_ORCH_MODEL:-}"
    if [[ -n "$orch_model" ]]; then
      role="$(model_role "$orch_model")"
      [[ -n "$role" ]] || die "FORGE_ORCH_MODEL='$orch_model' is not in $MODELS_FILE"
      case "$role" in
        orchestrator|both) ;;
        *) die "FORGE_ORCH_MODEL='$orch_model' has role '$role' — it cannot be the orchestrator" ;;
      esac
      prov="$(provider_of "$orch_model")"
      [[ "$prov" == "claude" ]] || die "the orchestrator must be a claude model (got '$orch_model' on '$prov')"
      orch_cmd="$(provider_cmd claude) --model $orch_model"
    else
      orch_cmd="$(provider_cmd claude)"
    fi
  fi
  tmux new-session -d -s "$FORGE_SESSION" -n orchestrator -c "$ROOT" "$orch_cmd; exec ${SHELL:-bash}"
  # Mouse mode is OFF by default, because with it on the wheel does not scroll
  # the orchestrator window — it throws it into tmux copy-mode instead.
  #
  # tmux's own WheelUpPane binding is:
  #   if -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" \
  #     { send-keys -M } { copy-mode -e }
  # i.e. the wheel reaches the application only if the pane is on the alternate
  # screen or the application asked for mouse events. Claude Code 2.1.312 does
  # neither (measured: all three flags 0), so tmux takes the copy-mode branch:
  # the view jumps to the scrollback, keystrokes go to copy-mode, and the text
  # you wanted to read is out of reach. Mouse off keeps the terminal's own
  # scrolling and text selection in every window.
  #
  # The cost is the wheel in worker windows; their logs are on the dashboard,
  # and Ctrl-b [ still scrolls a pane. Set FORGE_MOUSE=on to get it back.
  tmux set-option -t "$FORGE_SESSION" mouse "$mouse"
  tmux set-option -t "$FORGE_SESSION" history-limit 50000
  tmux set-option -t "$FORGE_SESSION" status on
  # Esc is used by Claude Code to cancel; tmux's default 500ms delay makes it feel stuck.
  [[ "$(tmux show-options -sv escape-time 2>/dev/null)" -gt 50 ]] 2>/dev/null && tmux set-option -s escape-time 10
  tmux new-window -d -t "$FORGE_SESSION:" -n dashboard -c "$ROOT" \
    "python3 '$FORGE_HOME/bin/forge-dashboard' --root '$ROOT' --port $port; exec ${SHELL:-bash}"

  if [[ "${FORGE_TUNNEL:-0}" == "1" ]]; then
    [[ -n "${FORGE_DASH_TOKEN:-}" ]] || info "WARNING: tunnel without FORGE_DASH_TOKEN — anyone with the URL sees your logs"
    if [[ -n "${FORGE_TUNNEL_NAME:-}" ]]; then
      tcmd="cloudflared tunnel --url http://127.0.0.1:$port run '$FORGE_TUNNEL_NAME'"   # named tunnel (+ Cloudflare Access)
    else
      tcmd="cloudflared tunnel --url http://127.0.0.1:$port"                          # quick *.trycloudflare.com URL
    fi
    tmux new-window -d -t "$FORGE_SESSION:" -n tunnel "$tcmd; exec ${SHELL:-bash}"
  fi
  info "session '$FORGE_SESSION' started — dashboard: http://127.0.0.1:$port"
fi

if [[ $attach -eq 1 ]]; then
  if [[ -n "${TMUX:-}" ]]; then tmux switch-client -t "$FORGE_SESSION"; else tmux attach -t "$FORGE_SESSION"; fi
fi
