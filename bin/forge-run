#!/usr/bin/env bash
# forge-run <name> — internal: runs inside the agent's tmux window.
# Executes Codex non-interactively in the worktree, then commits the result.
#
# Two kinds of worker (set by forge-spawn --kind, default "build"):
#   build     — changes code. A commit is expected; no diff means nochanges.
#   analysis  — reads and reasons. The deliverable IS the report, so it is kept
#               in the tree (reports/<name>.md) and committed like any artifact.
source "$(dirname "$0")/forge-lib.sh" || exit 1
[[ $# -ge 1 ]] || die "usage: forge-run <name>   (internal: started by forge-spawn)"
name="$1"; valid_name "$name"

wt="$(agent_get "$name" worktree)"
log="$STATE/logs/$name.log"
# set -e would abort here anyway, but silently: the worker's window would close
# with no reason given. A missing worktree means someone removed it under a
# running agent, which is worth saying out loud.
cd "$wt" || die "worktree is gone: $wt (was the agent cleaned up while running?)"

kind="$(agent_get "$name" kind)"; kind="${kind:-build}"
report_dir="${FORGE_REPORT_DIR:-reports}"
# Created here rather than by the worker. An antigravity worker has no blanket
# shell permission (see agy_permissions), so "create the directory if needed"
# cost it a denied command and, with it, the whole run — measured with agy
# 1.4.11. Every provider can write into a directory that already exists.
mkdir -p "$report_dir"

if [[ "$kind" == "analysis" ]]; then
  deliverable="This is an ANALYSIS task. You are not required to change code.
Your deliverable is the report itself: write it to $report_dir/$name.md in the
repository root (the directory already exists). Make it self-contained —
record sources, file paths, line/row references and hashes for every claim, so
a reader can re-check it without rerunning you. State explicitly what you could
NOT determine; \"unresolved, and here is the missing evidence\" is a correct and
accepted result, far better than a guess. Do not overstate: absence of a finding
is not proof of completeness."
else
  deliverable="This is a BUILD task. Run the acceptance check stated below before
finishing. When done, write a short summary of what you changed and anything
left open to $report_dir/$name.md in the repository root (the directory
already exists)."
fi

prompt="You are a forge worker on branch agent/$name. Follow AGENTS.md.
Work only inside this directory. Do not commit — the harness commits for you.

$deliverable

TASK:
$(cat "$STATE/tasks/$name.md")"

model="$(agent_get "$name" model)"
effort="$(agent_get "$name" effort)"
provider="$(agent_get "$name" provider)"
provider="${provider:-$(provider_of "$model")}"
CMD="$(provider_cmd "$provider")"

# Each CLI spells "run once, non-interactively, allowed to edit this directory"
# differently, so the argv is built per provider rather than shared. Verified
# 2026-10-30 against codex-cli 0.163.0, claude 2.1.312, agy 1.4.11.
case "$provider" in
  codex)
    # `codex exec` is non-interactive, so workspace-write never prompts.
    # (Codex CLI dropped --full-auto in 0.163.0 in favour of -s/--sandbox.)
    read -r -a ARGS <<< "${FORGE_CODEX_ARGS:--s workspace-write}"
    ARGS=(exec "${ARGS[@]}")
    [[ -n "$model" ]] && ARGS+=(-m "$model")
    # Reasoning effort has no dedicated flag; it is a config override.
    # The key is model_reasoning_effort — plain `reasoning_effort` is ignored.
    [[ -n "$effort" ]] && ARGS+=(-c "model_reasoning_effort=\"$effort\"")
    ARGS+=("$prompt")
    ;;
  claude)
    # -p is one-shot. Permissions must be granted explicitly or the worker
    # stalls on the first edit with nobody there to approve it; the sandbox is
    # the worktree, which is why this is acceptable here and not in general.
    read -r -a ARGS <<< "${FORGE_CLAUDE_ARGS:---permission-mode acceptEdits}"
    ARGS=(-p "${ARGS[@]}")
    [[ -n "$model" ]] && ARGS+=(--model "$model")
    ARGS+=("$prompt")
    ;;
  antigravity)
    # The prompt is attached to the flag as -p=<prompt>, and goes LAST.
    # Measured against agy 1.4.11: a bare `-p <prompt> --output-format json`
    # makes -p swallow the next token as its value ("-p took --output-format
    # as its prompt"), silently dropping the real task. Attaching it removes
    # the ordering hazard entirely.
    #
    # Permissions are an explicit allowlist because agy auto-denies anything
    # it would have to prompt for (see agy_permissions in forge-lib.sh) — and
    # reports SUCCESS anyway, which is why the denial check runs below.
    # stream-json, not json. Both end with the same envelope (status, usage,
    # denied_actions), but `json` prints ONLY that envelope — and its
    # denied_actions says just {"action": "command"}, never which command.
    # stream-json additionally emits a step_update per tool call carrying
    # run_command.error.message, which names it:
    #   "user denied permission to run command:\nls -la"
    # Measured against agy 1.4.12, same brief and same allowlist:
    #   json        -> [{"action": "command", "display_name": "RunCommand"}]
    #   stream-json -> ['ls -la']
    # An operator was left to rerun the brief by hand to find that out, at
    # four workers' worth of diagnosis. Nothing is lost by the switch: the
    # envelope is still there, so usage parsing is unaffected.
    read -r -a ARGS <<< "${FORGE_AGY_ARGS:---output-format stream-json}"
    # The subset forge-spawn --commands recorded, or empty for the whole bound.
    read -r -a WCMDS <<< "$(agent_get "$name" commands)"
    ARGS+=(--settings "$(agy_permissions ${WCMDS[@]+"${WCMDS[@]}"})")
    slug="$(provider_slug antigravity "$model")"
    [[ -n "$slug" ]] || die "model '$model' has no 'slug' line in $MODELS_FILE (see forge-models)"
    ARGS+=(--model "$slug")
    # Effort is part of the slug for every agy model, and passing --effort as
    # well is a hard error ("--model X conflicts with --effort=Y"), so it is
    # dropped rather than allowed to fail the spawn.
    [[ -n "$effort" ]] && echo "note: --effort is ignored for antigravity models (effort is part of the slug '$slug')" >&2
    ARGS+=(-p="$prompt")
    ;;
esac

agent_set "$name" status=running provider="$provider" started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "=== forge worker '$name' ($kind) — $provider — model: ${model:-provider default}${effort:+ — effort: $effort} — $(date) ===" > "$log"

# Plan quota before the work, so what this one task cost can be stated in plan
# terms and not only in tokens. Only this worker's own provider is asked: the
# others cannot change because of it, and each reading costs 1-4s.
#
# Backgrounded deliberately. The worker starts immediately and the reading
# lands while it runs — a provider CLI that is slow to start must not delay
# the actual work. Failure is ignored (|| true): a missing plan figure is
# worth less than the run.
#
# Run from $STATE, not from the worktree. `claude -p` writes its transcript to
# a directory derived from the CWD, so reading the plan from inside the
# worktree would drop a .jsonl beside the worker's own files — and forge-run
# commits with `git add -A`, so it would land in the worker's commit.
mkdir -p "$STATE/usage"
plan_before="$STATE/usage/$name.plan-before.json"
( cd "$STATE" && "$FORGE_HOME/bin/forge-plan" --json --provider "$provider" \
    > "$plan_before" 2>/dev/null || true ) &
plan_pid=$!

set +e
"$CMD" "${ARGS[@]}" 2>&1 | tee -a "$log"
rc=${PIPESTATUS[0]}
set -e

# Antigravity reports token usage only in its headless JSON envelope, with no
# durable per-turn log of its own, so it is captured here or not at all.
#
# It also auto-denies any tool it cannot prompt for and STILL exits 0 with
# status SUCCESS — measured against agy 1.4.11. A worker that was never allowed
# to write is indistinguishable from one that chose not to, so denied_actions
# is promoted to a hard failure here; otherwise forge would report "done" for a
# worker that did nothing. FORGE_AGY_COMMANDS widens the command allowlist.
if [[ "$provider" == "antigravity" ]]; then
  mkdir -p "$STATE/usage"
  # NOTE for anyone editing the Python below: it sits in a heredoc inside a
  # $(...) substitution, which bash parses for quotes BEFORE the heredoc
  # protects it. An apostrophe in a comment ("forge's default") makes bash
  # fail with "unexpected EOF while looking for matching )" pointing at this
  # line, not at the comment. Keep apostrophes and backticks out of it.
  denied="$(python3 - "$log" "$STATE/usage/$name.json" "$wt" "$model" <<'PYEOF' || true
import json, re, sys
log, out, cwd, model = sys.argv[1:5]
text = open(log, encoding="utf-8", errors="replace").read()

# Two things are pulled out of the log, and they live in different places.
#
# 1. The envelope: the last complete JSON object carrying both usage and
#    status. Scanned this way rather than by reading the last line because
#    agy prints notices before it, and because this must keep working for a
#    worker run with FORGE_AGY_ARGS="--output-format json", where the
#    envelope is the only object there is.
#
# 2. The commands that were actually denied. The envelope does NOT name them
#    — denied_actions says only {"action": "command"}. Under stream-json
#    the default in forge since this was measured, each tool call gets a
#    step_update whose run_command.error.message reads
#    "user denied permission to run command:" followed by the command. That
#    is the only place the command appears, so it is read from there and put
#    in the failure message. Measured against agy 1.4.12, same brief and same
#    allowlist: json named only the action "command", while stream-json named
#    the command itself, ls -la.
env = None
denied_cmds = []
for m in re.finditer(r"\{", text):
    try:
        obj, _ = json.JSONDecoder().raw_decode(text[m.start():])
    except ValueError:
        continue
    if not isinstance(obj, dict):
        continue
    if "usage" in obj and "status" in obj:
        env = obj
    # stream-json nests the envelope under "result"; json has it bare.
    res = obj.get("result")
    if isinstance(res, dict) and "usage" in res and "status" in res:
        env = res
    su = obj.get("step_update")
    if isinstance(su, dict):
        ti = su.get("tool_info") or {}
        msg = ((ti.get("error") or {}).get("message") or "")
        if "denied permission to run command" in msg:
            cmd = (ti.get("parameters") or {}).get("CommandLine")
            if cmd and cmd not in denied_cmds:
                denied_cmds.append(cmd)
if env is None:
    sys.exit(0)
json.dump({"provider": "antigravity", "cwd": cwd, "model": model,
           "status": env.get("status", ""), "usage": env.get("usage") or {},
           "denied_actions": env.get("denied_actions") or [],
           "denied_commands": denied_cmds},
          open(out, "w"), indent=1)

# Printed for the shell: the commands when they are known, the bare action
# names otherwise (a worker run with --output-format json has no step_updates).
if denied_cmds:
    print("CMDS\t" + "\t".join(denied_cmds))
else:
    names = sorted({(d or {}).get("action", "?")
                    for d in (env.get("denied_actions") or [])})
    if names:
        print("ACTIONS\t" + ",".join(names))
PYEOF
)"
  if [[ -n "$denied" ]]; then
    rc=1
    # The parser prints either "CMDS<tab>cmd<tab>cmd" when it recovered the
    # actual command lines, or "ACTIONS<tab>names" when it could not (a worker
    # run with FORGE_AGY_ARGS="--output-format json" emits no step_updates).
    kind="${denied%%$'\t'*}"
    rest="${denied#*$'\t'}"
    if [[ "$kind" == "CMDS" ]]; then
      echo "=== agy was denied these commands ===" | tee -a "$log"
      # One per line, split on TABS only. An unquoted $(...) would word-split
      # on spaces too and print "ls -la" as two lines, which is how this was
      # first written and what the end-to-end test caught.
      printf '%s\n' "$rest" | tr '\t' '\n' | sed 's/^/      /' | tee -a "$log"
      first="$(printf '%s' "$rest" | cut -f1 | awk '{print $1}')"
      echo "    The first program it needed was: ${first:-?}" | tee -a "$log"
    else
      echo "=== agy auto-denied required tool(s): $rest ===" | tee -a "$log"
    fi
    echo "    The run reported SUCCESS but was not permitted to act." | tee -a "$log"
    echo "    This worker was allowed:$(agy_denial_hint "${WCMDS[@]+${WCMDS[@]}}")" | tee -a "$log"
    echo "    agy wraps a check as 'cd <dir> && <cmd>; echo ...', so EVERY" | tee -a "$log"
    echo "    program in it needs a rule — cd and echo included." | tee -a "$log"
    # The envelope says only {"action":"command"}; it never names the command.
    # Measured against agy 1.4.12: --output-format stream-json DOES carry it,
    # as run_command.error.message on the denied step. So say where the answer
    # is instead of pretending this message holds it. And name the usual
    # culprit: not the task's own command, but one agy ran to orient itself.
    if [[ "$kind" != "CMDS" ]]; then
      # Only reachable when the operator overrode the output format, since
      # forge now defaults to stream-json, which names the commands above.
      cat >>"$log" <<'DENYHINT'
    This run used --output-format json, whose envelope does not say WHICH
    command was denied. Drop FORGE_AGY_ARGS to get the default stream-json,
    which names it.
DENYHINT
    fi
    cat >>"$log" <<'DENYHINT'
    Note that the denied command is often NOT the one the task is about but
    one agy runs to orient itself on its first turn, such as "ls -la". forge
    grants cd/echo/ls/cat for exactly that, so a commands.conf that drops one
    of them brings this back.
DENYHINT
    tail -12 "$log"
  fi
fi

# The report is a deliverable, not scratch: it stays in the tree so it lands in
# the commit. FORGE_REPORT.md in the root is still accepted (older AGENTS.md
# tells workers to write it there) and is moved into place.
report_path="$report_dir/$name.md"
if [[ -f FORGE_REPORT.md ]]; then
  mkdir -p "$report_dir"
  if [[ -f "$report_path" ]]; then
    # Worker wrote both: keep both rather than silently dropping one.
    printf '\n\n---\n\n## FORGE_REPORT.md\n\n' >> "$report_path"
    cat FORGE_REPORT.md >> "$report_path"
  else
    mv FORGE_REPORT.md "$report_path"
  fi
  rm -f FORGE_REPORT.md
fi

report=""
if [[ -f "$report_path" ]]; then
  cp "$report_path" "$STATE/logs/$name.report.md"
  # Full text goes to the log copy and the commit; the JSON field is only a
  # preview for forge-status/review/dashboard, so note where the rest lives.
  report="$(head -c 4000 "$report_path")"
  if [[ "$(wc -c < "$report_path")" -gt 4000 ]]; then
    report="$report

[...truncated preview — full report: $report_path (in commit) and $STATE/logs/$name.report.md]"
  fi
  agent_set "$name" report_path="$report_path"
fi

if [[ $rc -ne 0 ]]; then
  # A worker that ran out of plan quota did not fail at the task: it never got
  # to finish one. Recorded as `exhausted` rather than `failed` so the
  # orchestrator can tell the two apart — a failed worker needs a new brief, an
  # exhausted one needs only a later retry with the same brief. ex24-audit
  # (2026-10-28) passed the whole quality gate and died writing its report;
  # stored as `failed`, that near-success was indistinguishable from a worker
  # with a bad CLI flag.
  #
  # The patterns below are taken from real logs, not guessed. Both matter:
  #   codex: "ERROR: You've hit your usage limit." + "try again at <time>",
  #          exit 1. NOTE the apostrophe is U+2019, not ASCII — an ASCII
  #          pattern never matches.
  #   agy:   "RESOURCE_EXHAUSTED (code 429)" / "Individual quota reached",
  #          exit 3, with "Resets in <duration>".
  # Only the log tail is scanned: a worker that read a quota error out of some
  # file it was auditing must not be relabelled because of its input.
  status_final=failed
  if tail -c 4000 "$log" | grep -qE \
      'hit your usage limit|RESOURCE_EXHAUSTED|Individual quota reached|quota reached'; then
    status_final=exhausted
  fi
  agent_set "$name" status="$status_final" exit_code="$rc" report="$report"
  if [[ "$status_final" == exhausted ]]; then
    echo "=== plan quota exhausted (exit $rc) — same brief, retry later: forge-retry $name ===" | tee -a "$log"
  else
    echo "=== codex exited with $rc — worktree left uncommitted for inspection ===" | tee -a "$log"
  fi
else
  git add -A
  if git diff --cached --quiet; then
    # An analysis worker that produced no report really did produce nothing;
    # with a report it commits above, like any other deliverable.
    agent_set "$name" status=nochanges exit_code=0 report="$report"
    if [[ "$kind" == "analysis" ]]; then
      echo "=== no report written to $report_path — nothing to commit ===" | tee -a "$log"
    else
      echo "=== no changes produced ===" | tee -a "$log"
    fi
  else
    msg="[agent:$name] $(agent_get "$name" title)"
    git commit -q -m "$msg" -m "${report:-No report.}"
    agent_set "$name" status=done exit_code=0 commit="$(git rev-parse --short HEAD)" report="$report"
    echo "=== committed $(git rev-parse --short HEAD) on agent/$name ===" | tee -a "$log"
  fi
fi
agent_set "$name" finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Plan quota after the work. The "before" reading was backgrounded at startup,
# so wait for it first — without that, a worker that finished in under a second
# would compare against a file that is still being written.
wait "$plan_pid" 2>/dev/null || true
plan_after="$STATE/usage/$name.plan-after.json"
( cd "$STATE" && "$FORGE_HOME/bin/forge-plan" --json --provider "$provider" \
  > "$plan_after" 2>/dev/null || true )
if [[ -s "$plan_before" && -s "$plan_after" ]]; then
  # The delta is computed now, not at display time: the two readings are only
  # comparable at this moment. By the time anyone looks, other workers and the
  # operator's own sessions have moved the numbers.
  #
  # --diff lives in forge-plan rather than in a heredoc here so that it can be
  # tested directly against saved fixtures.
  "$FORGE_HOME/bin/forge-plan" --diff "$plan_before" "$plan_after" \
    --out "$STATE/usage/$name.plan.json" 2>/dev/null | tee -a "$log" || true
  rm -f "$plan_before" "$plan_after"
fi

# Keep the window open so the operator can look around; set FORGE_KEEP_WINDOW=0 to close.
[[ "${FORGE_KEEP_WINDOW:-1}" == "1" ]] && exec "${SHELL:-bash}"
exit 0
