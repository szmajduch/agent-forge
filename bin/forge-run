#!/usr/bin/env bash
# forge-run <name> — internal: runs inside the agent's tmux window.
# Executes Codex non-interactively in the worktree, then commits the result.
#
# Two kinds of worker (set by forge-spawn --kind, default "build"):
#   build     — changes code. A commit is expected; no diff means nochanges.
#   analysis  — reads and reasons. The deliverable IS the report, so it is kept
#               in the tree (reports/<name>.md) and committed like any artifact.
source "$(dirname "$0")/forge-lib.sh" || exit 1
[[ $# -ge 1 ]] || die "usage: forge-run <name>   (internal: started by forge-spawn)"
name="$1"; valid_name "$name"

wt="$(agent_get "$name" worktree)"
log="$STATE/logs/$name.log"
cd "$wt"

CODEX_CMD="${FORGE_CODEX_CMD:-codex}"
# Default: sandboxed, can write inside the worktree, no approval prompts.
# `codex exec` is non-interactive, so workspace-write never prompts.
# (Codex CLI dropped --full-auto in 0.163.0 in favour of -s/--sandbox.)
read -r -a CODEX_ARGS <<< "${FORGE_CODEX_ARGS:--s workspace-write}"
model="$(agent_get "$name" model)"
[[ -n "$model" ]] && CODEX_ARGS+=(-m "$model")
# Reasoning effort has no dedicated flag; it is a config override.
# The key is model_reasoning_effort — plain `reasoning_effort` is ignored.
effort="$(agent_get "$name" effort)"
[[ -n "$effort" ]] && CODEX_ARGS+=(-c "model_reasoning_effort=\"$effort\"")

kind="$(agent_get "$name" kind)"; kind="${kind:-build}"
report_dir="${FORGE_REPORT_DIR:-reports}"

if [[ "$kind" == "analysis" ]]; then
  deliverable="This is an ANALYSIS task. You are not required to change code.
Your deliverable is the report itself: write it to $report_dir/$name.md in the
repository root (create the directory if needed). Make it self-contained —
record sources, file paths, line/row references and hashes for every claim, so
a reader can re-check it without rerunning you. State explicitly what you could
NOT determine; \"unresolved, and here is the missing evidence\" is a correct and
accepted result, far better than a guess. Do not overstate: absence of a finding
is not proof of completeness."
else
  deliverable="This is a BUILD task. Run the acceptance check stated below before
finishing. When done, write a short summary of what you changed and anything
left open to $report_dir/$name.md in the repository root (create the directory
if needed)."
fi

prompt="You are a forge worker on branch agent/$name. Follow AGENTS.md.
Work only inside this directory. Do not commit — the harness commits for you.

$deliverable

TASK:
$(cat "$STATE/tasks/$name.md")"

agent_set "$name" status=running started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "=== forge worker '$name' ($kind) — model: ${model:-codex default}${effort:+ — effort: $effort} — $(date) ===" > "$log"

set +e
"$CODEX_CMD" exec "${CODEX_ARGS[@]}" "$prompt" 2>&1 | tee -a "$log"
rc=${PIPESTATUS[0]}
set -e

# The report is a deliverable, not scratch: it stays in the tree so it lands in
# the commit. FORGE_REPORT.md in the root is still accepted (older AGENTS.md
# tells workers to write it there) and is moved into place.
report_path="$report_dir/$name.md"
if [[ -f FORGE_REPORT.md ]]; then
  mkdir -p "$report_dir"
  if [[ -f "$report_path" ]]; then
    # Worker wrote both: keep both rather than silently dropping one.
    printf '\n\n---\n\n## FORGE_REPORT.md\n\n' >> "$report_path"
    cat FORGE_REPORT.md >> "$report_path"
  else
    mv FORGE_REPORT.md "$report_path"
  fi
  rm -f FORGE_REPORT.md
fi

report=""
if [[ -f "$report_path" ]]; then
  cp "$report_path" "$STATE/logs/$name.report.md"
  # Full text goes to the log copy and the commit; the JSON field is only a
  # preview for forge-status/review/dashboard, so note where the rest lives.
  report="$(head -c 4000 "$report_path")"
  if [[ "$(wc -c < "$report_path")" -gt 4000 ]]; then
    report="$report

[...truncated preview — full report: $report_path (in commit) and $STATE/logs/$name.report.md]"
  fi
  agent_set "$name" report_path="$report_path"
fi

if [[ $rc -ne 0 ]]; then
  agent_set "$name" status=failed exit_code="$rc" report="$report"
  echo "=== codex exited with $rc — worktree left uncommitted for inspection ===" | tee -a "$log"
else
  git add -A
  if git diff --cached --quiet; then
    # An analysis worker that produced no report really did produce nothing;
    # with a report it commits above, like any other deliverable.
    agent_set "$name" status=nochanges exit_code=0 report="$report"
    if [[ "$kind" == "analysis" ]]; then
      echo "=== no report written to $report_path — nothing to commit ===" | tee -a "$log"
    else
      echo "=== no changes produced ===" | tee -a "$log"
    fi
  else
    msg="[agent:$name] $(agent_get "$name" title)"
    git commit -q -m "$msg" -m "${report:-No report.}"
    agent_set "$name" status=done exit_code=0 commit="$(git rev-parse --short HEAD)" report="$report"
    echo "=== committed $(git rev-parse --short HEAD) on agent/$name ===" | tee -a "$log"
  fi
fi
agent_set "$name" finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Keep the window open so the operator can look around; set FORGE_KEEP_WINDOW=0 to close.
[[ "${FORGE_KEEP_WINDOW:-1}" == "1" ]] && exec "${SHELL:-bash}"
exit 0
