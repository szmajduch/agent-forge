#!/usr/bin/env bash
# forge-wait [name ...] [--timeout SEC]
# Blocks until the given workers (default: all active) leave queued/running,
# then prints forge-status. Exit 2 on timeout. Default timeout: 1800s.
#
# forge-status ends with any dashboard notes nobody has acknowledged, so the
# normal path surfaces them where a round ends. The timeout path used to exit
# without calling it at all — and a timeout is precisely when a waiting note
# ("is that worker stuck?") is worth reading, so it prints them too.
source "$(dirname "$0")/forge-lib.sh" || exit 1
timeout=1800; names=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --timeout)
      [[ -n "${2:-}" ]] || die "--timeout needs a value (seconds)"
      [[ "$2" =~ ^[0-9]+$ ]] || die "--timeout must be a whole number of seconds, got '$2'"
      timeout="$2"; shift 2 ;;
    --timeout=*)
      timeout="${1#--timeout=}"
      [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout must be a whole number of seconds, got '$timeout'"
      shift ;;
    --*) die "unknown option $1" ;;
    *) valid_name "$1"; names+=("$1"); shift ;;
  esac
done

# Reads state only. The reap is done by the caller below, in the main shell:
# active() is invoked as $(active), so anything it changed in its own variables
# — including which workers it reclaimed — dies with the subshell, and the
# operator would never be told why the wait ended.
active() {
  local f s
  shopt -s nullglob
  if [[ ${#names[@]} -gt 0 ]]; then
    for n in "${names[@]}"; do s="$(agent_get "$n" status)"; [[ "$s" == queued || "$s" == running ]] && echo "$n"; done
  else
    for f in "$STATE"/agents/*.json; do jq -r 'select(.status=="queued" or .status=="running") | .name' "$f"; done
  fi
  return 0
}

start=$SECONDS
# Reaped before every poll, not once up front: a worker can die at any point
# during the wait, which is the case this exists for. Without it the loop
# blocks for the full timeout on a status nothing is left alive to write —
# measured: killing a running worker's window made forge-wait sit out its
# whole 1800s default.
reap_stale; report_stale
while [[ -n "$(active)" ]]; do
  if (( SECONDS - start >= timeout )); then
    echo "timeout; still active: $(active | tr '\n' ' ')"
    # The notes, but not the whole worker table: the names still running were
    # just printed above, and repeating the table would bury them.
    "$FORGE_HOME/bin/forge-status" --feedback-only || true
    exit 2
  fi
  sleep 5
  reap_stale; report_stale
done
"$FORGE_HOME/bin/forge-status"
